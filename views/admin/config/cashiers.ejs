
<%- include("../../partials/header", { title: "Configuration des Caisses" }) %>
<%- include("../../partials/navbar", { activePage: "admin", user: user }) %>

<style>
  .content-wrapper { background-color: #f0f2f5; }
</style>

<div class="container-fluid py-3 px-4 content-wrapper">
  <div class="row">
    <div class="col-md-8 offset-md-2">
      <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
          <h5 class="mb-0"><i class="fas fa-cash-register me-2"></i>Configuration des Caisses</h5>
        </div>
        <div class="card-body">
          <p class="text-muted mb-4">Gérez les postes de caisse disponibles dans l'établissement.</p>
          <% if (typeof success !== "undefined" && success) { %>
            <div class="alert alert-success">Configuration mise à jour avec succès.</div>
          <% } %>
          <% if (typeof errors !== "undefined" && errors.length > 0) { %>
            <div class="alert alert-danger"><ul class="mb-0"><% errors.forEach(e => { %><li><%- e %></li><% }) %></ul></div>
          <% } %>
          <form method="POST" action="/admin/config/cashiers">
            <input type="hidden" name="_csrf" value="<%- csrfToken %>">
            <div class="mb-3"><label class="form-label">Nom de la caisse</label><input type="text" name="name" class="form-control form-control-sm" value="<%- typeof config !== "undefined" && config.name ? config.name : "" %>"></div>
<div class="mb-3"><label class="form-label">Emplacement</label><input type="text" name="location" class="form-control form-control-sm" value="<%- typeof config !== "undefined" && config.location ? config.location : "" %>"></div>
<div class="mb-3"><label class="form-label">Caissier responsable</label><select name="cashier_id" class="form-select form-select-sm"><option value="">-- Sélectionner --</option></select></div>
            <div class="text-end mt-3">
              <a href="/" class="btn btn-secondary btn-sm">Annuler</a>
              <button type="submit" class="btn btn-primary btn-sm ms-2"><i class="fas fa-save me-1"></i>Enregistrer</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include("../../partials/footer") %>




