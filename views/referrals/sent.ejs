
<%- include("../partials/header", { title: title }) %>
<%- include("../partials/navbar", { activePage: activePage, user: user }) %>

<div class="container-fluid py-3 px-4 content-wrapper">

  <div class="card shadow-sm">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-2">
      <h6 class="mb-0">
        <i class="fas fa-share-square me-2"></i>
        <%= locale==="fr" ? "Referrals envoyes" : "Sent Referrals" %>
      </h6>
      <a href="/encounters/worklist" class="btn btn-sm btn-outline-light">
        <i class="fas fa-arrow-left me-1"></i><%= locale==="fr" ? "Retour" : "Back" %>
      </a>
    </div>
    <div class="card-body p-0">
      <% if (!referrals || referrals.length === 0) { %>
        <div class="text-center text-muted py-5">
          <i class="fas fa-inbox fa-2x mb-2 d-block opacity-50"></i>
          <%= locale==="fr" ? "Aucun referral envoye." : "No referrals sent yet." %>
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
              <tr>
                <th class="ps-3"><%= locale==="fr" ? "Patient" : "Patient" %></th>
                <th><%= locale==="fr" ? "Vers" : "To" %></th>
                <th><%= locale==="fr" ? "Urgence" : "Urgency" %></th>
                <th><%= locale==="fr" ? "Raison" : "Reason" %></th>
                <th><%= locale==="fr" ? "Statut" : "Status" %></th>
                <th><%= locale==="fr" ? "Notes cliniques" : "Clinical Notes" %></th>
                <th>Date</th>
              </tr>
            </thead>
            <tbody>
              <% referrals.forEach(function(r) { %>
                <tr>
                  <td class="ps-3">
                    <%= r.patient ? (r.patient.name_first + " " + r.patient.name_last) : "—" %>
                  </td>
                  <td><%= r.toFacility ? r.toFacility.name : "—" %></td>
                  <td>
                    <% if (r.urgency === "emergency") { %>
                      <span class="badge bg-danger"><%= locale==="fr" ? "Urgence vitale" : "Emergency" %></span>
                    <% } else if (r.urgency === "urgent") { %>
                      <span class="badge bg-warning text-dark"><%= locale==="fr" ? "Urgent" : "Urgent" %></span>
                    <% } else { %>
                      <span class="badge bg-secondary"><%= locale==="fr" ? "Routine" : "Routine" %></span>
                    <% } %>
                  </td>
                  <td style="max-width:260px;"><%= r.reason %></td>
                  <td>
                    <% if (r.status === "sent") { %>
                      <span class="badge bg-info text-dark"><%= locale==="fr" ? "Envoye" : "Sent" %></span>
                    <% } else if (r.status === "accepted") { %>
                      <span class="badge bg-primary"><%= locale==="fr" ? "Accepte" : "Accepted" %></span>
                    <% } else if (r.status === "seen") { %>
                      <span class="badge bg-success"><%= locale==="fr" ? "Vu" : "Seen" %></span>
                    <% } else if (r.status === "completed") { %>
                      <span class="badge bg-success"><%= locale==="fr" ? "Termine" : "Completed" %></span>
                    <% } else if (r.status === "declined") { %>
                      <span class="badge bg-danger" title="<%= r.decline_reason || '' %>">
                        <%= locale==="fr" ? "Refuse" : "Declined" %>
                      </span>
                    <% } %>
                  </td>
                  <td style="max-width:280px;white-space:pre-line;font-size:.82rem;">
                    <%= r.receiving_notes || "—" %>
                  </td>
                  <td><%= r.created_at ? String(r.created_at).slice(0,10) : "—" %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>

</div>

<%- include("../partials/footer") %>
