        <%/* 7-day combined sales + unpaid chart — billing clerk and admin only */%>
        <% if ((isBillingStaff || isAdmin || isAppAdmin) &&
               typeof unpaidLast7 !== "undefined" && unpaidLast7.length > 0) { %>
          <div class="card shadow-sm mb-4">
            <div class="card-header py-2 d-flex justify-content-between align-items-center">
              <span class="fw-bold" style="font-size:.82rem;">
                <i class="fas fa-chart-bar me-2 text-primary"></i>
                <%= locale==="fr"
                  ? "Ventes et factures payees (mois en cours)"
                  : "Daily Collections & Paid Bills (current month)" %>
              </span>
              <div style="font-size:.70rem;color:#6c757d;">
                <span class="me-3">
                  <span style="display:inline-block;width:10px;height:10px;
                    background:rgba(13,110,253,.6);border-radius:2px;vertical-align:middle;"></span>
                  &nbsp;<%= locale==="fr" ? "Encaisse (FCFA)" : "Collected (FCFA)" %>
                </span>
                <span>
                  <span style="display:inline-block;width:14px;height:3px;
                    background:#198754;vertical-align:middle;border-radius:2px;"></span>
                  &nbsp;<%= locale==="fr" ? "Factures payees (nb)" : "Paid bills (count)" %>
                </span>
              </div>
            </div>
            <div class="card-body py-3" style="height:200px;position:relative;">
              <canvas id="salesUnpaidChartAdmin"></canvas>
            </div>
          </div>
          <script>
          (function() {
            var labels  = [<% unpaidLast7.forEach(function(d,i) {
              var p = d.date.split("-"); var lbl = p[1]+"-"+p[2];
            %>"<%= lbl %>"<% if(i<unpaidLast7.length-1){%>,<%} }); %>];
            var sales   = [<% if(typeof salesLast7!=="undefined"){
              salesLast7.forEach(function(d,i){
            %><%= Math.round(d.total) %><%if(i<salesLast7.length-1){%>,<%}})}; %>];
            var unpaid  = [<% unpaidLast7.forEach(function(d,i){
              %><%= d.count %><%if(i<unpaidLast7.length-1){%>,<%}}); %>];
            var ctx = document.getElementById('salesUnpaidChartAdmin');
            if (!ctx) return;
            new Chart(ctx, {
              data: {
                labels: labels,
                datasets: [
                  {
                    type: 'bar',
                    label: "<%= locale==="fr"?"Encaisse (FCFA)":"Collected (FCFA)" %>",
                    data:  sales,
                    backgroundColor: 'rgba(13,110,253,.55)',
                    borderColor: '#0d6efd',
                    borderWidth: 1,
                    yAxisID: 'ySales',
                    order: 2,
                  },
                  {
                    type: 'line',
                    label: "<%= locale==="fr"?"Factures payees":"Paid bills" %>",
                    data:  unpaid,
                    borderColor: '#198754',
                    backgroundColor: 'rgba(25,135,84,.12)',
                    borderWidth: 2,
                    pointRadius: 4,
                    pointBackgroundColor: '#198754',
                    fill: false,
                    tension: 0.3,
                    yAxisID: 'yUnpaid',
                    order: 1,
                  }
                ]
              },
              options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                plugins: {
                  legend: { display: false },
                  tooltip: {
                    callbacks: {
                      label: function(ctx) {
                        if (ctx.dataset.yAxisID === 'ySales') {
                          return ' ' + Math.round(ctx.parsed.y).toLocaleString('fr-FR') + ' FCFA';
                        }
                        return ' ' + ctx.parsed.y +
                          " <%= locale==="fr"?"facture(s) payee(s)":"paid bill(s)" %>";
                      }
                    }
                  }
                },
                scales: {
                  ySales: {
                    type: 'linear', position: 'left',
                    beginAtZero: true,
                    ticks: {
                      font: { size: 10 },
                      callback: function(v) {
                        return v >= 1000
                          ? (v/1000).toLocaleString('fr-FR') + 'k'
                          : v.toLocaleString('fr-FR');
                      }
                    },
                    grid: { color: 'rgba(0,0,0,.04)' },
                  },
                  yUnpaid: {
                    type: 'linear', position: 'right',
                    beginAtZero: true,
                    ticks: { font: { size: 10 }, stepSize: 1 },
                    grid: { drawOnChartArea: false },
                  },
                  x: { ticks: { font: { size: 10 } } }
                }
              }
            });
          })();
          </script>
        <% } %>

        <%/* Recent activity accordion */%>
        <div class="accordion" id="activityAccordion">
          <div class="accordion-item border-0 shadow-sm">
            <h2 class="accordion-header" id="activityHeading">
              <button class="accordion-button collapsed py-2" type="button"
                data-bs-toggle="collapse" data-bs-target="#activityCollapse"
                aria-expanded="false" aria-controls="activityCollapse"
                style="font-size:.78rem;font-weight:700;text-transform:uppercase;
                       letter-spacing:.08em;color:#6c757d;background:#fff;">
                <i class="fas fa-history me-2"></i>
                <%= t.dash.recentActivity %>
                <% if (typeof recentActivity !== "undefined" && recentActivity.length > 0) { %>
                  <span class="badge bg-secondary ms-2" style="font-size:.65rem;">
                    <%= recentActivity.length %>
                  </span>
                <% } %>
              </button>
            </h2>
            <div id="activityCollapse" class="accordion-collapse collapse"
              aria-labelledby="activityHeading" data-bs-parent="#activityAccordion">
              <div class="accordion-body p-0">
                <div class="table-responsive">
                  <table class="table table-hover mb-0" style="font-size:.80rem;">
                    <thead class="table-light">
                      <tr>
                        <th class="ps-3"><%= t.dash.actUser %></th>
                        <th><%= t.dash.actAction %></th>
                        <th><%= t.dash.actIp %></th>
                        <th class="pe-3"><%= t.dash.actDate %></th>
                      </tr>
                    </thead>
                    <tbody>
                      <% if (typeof recentActivity !== "undefined" && recentActivity.length > 0) { %>
                        <% recentActivity.forEach(function(log) { %>
                          <tr>
                            <td class="ps-3"><strong><%= log.username %></strong></td>
                            <td>
                              <%
                                var note = log.lognote || "";
                                var nl = note.toLowerCase();
                                var bc = "bg-secondary";
                                if (nl.includes("connexion") || nl.includes("login"))         bc = "bg-success";
                                else if (nl.includes("deconnexion") || nl.includes("logout")) bc = "bg-secondary";
                                else if (nl.includes("cree") || nl.includes("created") ||
                                         nl.includes("enregistre") || nl.includes("admitted")) bc = "bg-primary";
                                else if (nl.includes("mis a jour") || nl.includes("updated") ||
                                         nl.includes("activated") || nl.includes("transferred")) bc = "bg-info text-dark";
                                else if (nl.includes("discharged") || nl.includes("closed"))  bc = "bg-secondary";
                                else if (nl.includes("erreur") || nl.includes("error") ||
                                         nl.includes("failed"))                                bc = "bg-danger";
                              %>
                              <span class="badge <%= bc %> me-1" style="font-size:.6rem;">&nbsp;</span>
                              <small><%= note.length > 70 ? note.substring(0,70) + "..." : note %></small>
                            </td>
                            <td><small class="text-muted"><%= log.ip %></small></td>
                            <td class="pe-3">
                              <small class="text-muted">
                                <%= new Date(log.datetime).toLocaleString(
                                    locale==="fr" ? "fr-FR" : "en-GB",
                                    { day:"2-digit", month:"2-digit", year:"numeric",
                                      hour:"2-digit", minute:"2-digit" }) %>
                              </small>
                            </td>
                          </tr>
                        <% }); %>
                      <% } else { %>
                        <tr>
                          <td colspan="4" class="text-center text-muted py-4">
                            <i class="fas fa-history me-2"></i><%= t.dash.noActivity %>
                          </td>
                        </tr>
                      <% } %>
                    </tbody>
                  </table>
                </div>
                <% if (typeof recentActivity !== "undefined" && recentActivity.length > 0) { %>
                  <div class="text-end px-3 py-2 border-top">
                    <a href="/logs" class="btn btn-sm btn-outline-secondary">
                      <i class="fas fa-list me-1"></i><%= t.dash.viewAllLogs %>
                    </a>
                  </div>
                <% } %>
              </div>
            </div>
          </div>
        </div>

      <%/* ══════════════════════════════════════════════════════════
