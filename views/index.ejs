
<%- include("partials/header") %>
<%- include("partials/navbar") %>

<div class="container-fluid py-4 content-wrapper">
  <div class="row g-4">

    <%/* ── Left: Quick navigation ── */%>
    <div class="col-md-3">
      <div class="card shadow-sm mb-3">
        <div class="card-header bg-primary text-white py-2">
          <h6 class="mb-0"><i class="fas fa-compass me-2"></i><%= t.dash.quickNav %></h6>
        </div>
        <div class="list-group list-group-flush">

          <%/* Worklist — hidden for cashier-only */%>
          <% if (canSeeEncounterWorklist) { %>
            <a href="/encounters/worklist"
              class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
              <span><i class="fas fa-stethoscope me-2 text-primary"></i>
                <%= locale==="fr" ? "File des consultations" : "Encounter Worklist" %>
              </span>
              <% if (typeof pendingEncountersCount !== "undefined" && pendingEncountersCount > 0) { %>
                <span class="badge bg-warning text-dark rounded-pill" style="font-size:.65rem;">
                  <%= pendingEncountersCount %>
                </span>
              <% } %>
            </a>
          <% } %>

          <% if (!isCashierOnly && hasAnyPermission(["Patient.Read.PatientRecord","Patient.Create.PatientRecord"])) { %>
            <a href="/patients/list" class="list-group-item list-group-item-action">
              <i class="fas fa-user-injured me-2"></i><%= t.dash.managePatients %>
            </a>
          <% } %>

          <% if (!isCashierOnly && hasPermission("Pharmacy.Create.Prescription")) { %>
            <a href="/patients/prescriptions" class="list-group-item list-group-item-action">
              <i class="fas fa-file-prescription me-2"></i><%= t.dash.prescriptions %>
            </a>
          <% } %>

          <% if (hasAnyPermission(["Billing.Collect.Payment","Billing.Create.Bill"])) { %>
            <a href="/billing/worklist"
              class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
              <span><i class="fas fa-file-invoice-dollar me-2 text-success"></i><%= t.dash.invoicing %></span>
              <% if (typeof openBillsCount !== "undefined" && openBillsCount > 0) { %>
                <span class="badge bg-danger rounded-pill" style="font-size:.65rem;"><%= openBillsCount %></span>
              <% } %>
            </a>
          <% } %>

          <% if (!isCashierOnly && !isBillingStaff && hasAnyPermission(["Pharmacy.Dispense.Medication","Inventory.Read.Stock"])) { %>
            <a href="/pharmacy/distribution" class="list-group-item list-group-item-action">
              <i class="fas fa-pills me-2"></i><%= t.dash.pharmacy %>
            </a>
          <% } %>

          <% if (!isCashierOnly && !isBillingStaff && hasPermission("Appointment.Read.Appointment")) { %>
            <a href="/patients/appointments" class="list-group-item list-group-item-action">
              <i class="fas fa-calendar-check me-2"></i><%= t.dash.appointments %>
            </a>
          <% } %>

          <% if (hasAnyPermission(["Reports.Generate.FinancialData","Reports.Generate.ConsultationData"])) { %>
            <a href="/stats/finances" class="list-group-item list-group-item-action">
              <i class="fas fa-chart-line me-2"></i><%= t.dash.reports %>
            </a>
          <% } %>

          <%/* Sales report — cashier and billing staff */%>
          <% if (hasAnyPermission(["Billing.Collect.Payment","Billing.Create.Bill"])) { %>
            <a href="/billing/sales-report" class="list-group-item list-group-item-action">
              <i class="fas fa-receipt me-2 text-success"></i>
              <%= locale==="fr" ? "Rapport des ventes" : "Sales Report" %>
            </a>
          <% } %>

          <% if (isAppAdmin || isAdmin) { %>
            <a href="/admin/users/create" class="list-group-item list-group-item-action">
              <i class="fas fa-cog me-2"></i><%= t.dash.administration %>
            </a>
            <a href="/help/maintenance" class="list-group-item list-group-item-action">
              <i class="fas fa-wrench me-2"></i><%= t.dash.maintenance %>
            </a>
          <% } %>
        </div>
      </div>
    </div>

    <%/* ── Right: main content ── */%>
    <div class="col-md-9">

      <%/* Welcome banner */%>
      <div class="alert alert-success d-flex align-items-center mb-3 py-2" role="alert">
        <i class="fas fa-hospital-user fa-2x me-3"></i>
        <div>
          <h5 class="alert-heading mb-0">
            <%= t.dash.title %>
            <% if (user.facility && user.facility.id) { %>
              — <%= user.facility.name %>
            <% } else { %>
              — <%= locale==="fr" ? "Tous les etablissements" : "All Facilities" %>
            <% } %>
          </h5>
          <p class="mb-0" style="font-size:.88rem;">
            <%= t.dash.welcome %>,
            <strong>
              <% if (user.firstName && user.lastName) { %>
                <%= user.firstName %> <%= user.lastName %>
              <% } else { %>
                <%= user.username %>
              <% } %>
            </strong>!
            <%= t.dash.overview %>
          </p>
        </div>
      </div>

      <%/* ══════════════════════════════════════════════════════════
           CASHIER DASHBOARD
      ══════════════════════════════════════════════════════════ */%>
      <% if (isCashierOnly) { %>

        <h6 class="fw-bold text-uppercase text-muted mb-2" style="font-size:.72rem;letter-spacing:.08em;">
          <i class="fas fa-cash-register me-1"></i>
          <%= locale==="fr" ? "Encaissement" : "Cashier Overview" %>
        </h6>
        <div class="row g-3 mb-4">

          <%/* Open bills */%>
          <div class="col-md-6">
            <div class="card shadow-sm h-100" style="border-left:4px solid #dc3545;">
              <div class="card-body py-3">
                <div class="d-flex justify-content-between align-items-start">
                  <div>
                    <div class="lbl"><%= locale==="fr" ? "Factures a encaisser" : "Bills to collect" %></div>
                    <h2 class="mb-0 fw-bold" style="color:#dc3545;font-size:2.2rem;">
                      <%= typeof openBillsCount !== "undefined" ? openBillsCount : 0 %>
                    </h2>
                    <small class="text-muted" style="font-size:.72rem;">
                      <%= locale==="fr" ? "Ouvertes et partielles" : "Open and partial" %>
                    </small>
                  </div>
                  <i class="fas fa-file-invoice-dollar fa-2x opacity-50 mt-1" style="color:#dc3545;"></i>
                </div>
              </div>
              <a href="/billing/worklist" class="card-footer text-center py-1 text-decoration-none text-muted"
                style="font-size:.72rem;background:rgba(220,53,69,.08);">
                <%= locale==="fr" ? "Voir les factures" : "View bills" %> &rarr;
              </a>
            </div>
          </div>

          <%/* My payments today */%>
          <div class="col-md-6">
            <div class="card shadow-sm h-100" style="border-left:4px solid #198754;">
              <div class="card-body py-3">
                <div class="d-flex justify-content-between align-items-start">
                  <div>
                    <div class="lbl"><%= locale==="fr" ? "Encaissements auj." : "Payments today" %></div>
                    <h2 class="mb-0 fw-bold" style="color:#198754;font-size:2.2rem;">
                      <%= typeof myPaidTodayCount !== "undefined" ? myPaidTodayCount : 0 %>
                    </h2>
                    <small class="text-muted" style="font-size:.72rem;">
                      <%= locale==="fr" ? "Traites par moi" : "Processed by me" %>
                    </small>
                  </div>
                  <i class="fas fa-check-circle fa-2x opacity-50 mt-1" style="color:#198754;"></i>
                </div>
              </div>
              <a href="/billing/sales-report" class="card-footer text-center py-1 text-decoration-none text-muted"
                style="font-size:.72rem;background:rgba(25,135,84,.08);">
                <%= locale==="fr" ? "Voir le rapport" : "View report" %> &rarr;
              </a>
            </div>
          </div>

        </div>

        <%/* Open bills embedded table for cashier */%>
        <%- include("partials/open_bills_table", {
              enrichedOpenBills: enrichedOpenBills,
              locale: locale,
              hasAnyPermission: hasAnyPermission
            }) %>

      <%/* ══════════════════════════════════════════════════════════
           BILLING CLERK / FINANCE OFFICER DASHBOARD
      ══════════════════════════════════════════════════════════ */%>
      <% } else if (isBillingStaff) { %>

        <h6 class="fw-bold text-uppercase text-muted mb-2" style="font-size:.72rem;letter-spacing:.08em;">
          <i class="fas fa-file-invoice-dollar me-1"></i>
          <%= locale==="fr" ? "Apercu facturation" : "Billing Overview" %>
        </h6>
        <div class="row g-3 mb-4">

          <%/* Open bills */%>
          <div class="col-md-4">
            <div class="card shadow-sm h-100" style="border-left:4px solid #dc3545;">
              <div class="card-body py-3">
                <div class="d-flex justify-content-between align-items-start">
                  <div>
                    <div class="lbl"><%= locale==="fr" ? "Factures ouvertes" : "Open Bills" %></div>
                    <h2 class="mb-0 fw-bold" style="color:#dc3545;font-size:2.2rem;">
                      <%= typeof openBillsCount !== "undefined" ? openBillsCount : 0 %>
                    </h2>
                    <small class="text-muted" style="font-size:.72rem;">
                      <%= locale==="fr" ? "Ouvertes et partielles" : "Open and partial" %>
                    </small>
                  </div>
                  <i class="fas fa-file-invoice-dollar fa-2x opacity-50 mt-1" style="color:#dc3545;"></i>
                </div>
              </div>
              <a href="/billing/worklist" class="card-footer text-center py-1 text-decoration-none text-muted"
                style="font-size:.72rem;background:rgba(220,53,69,.08);">
                <%= locale==="fr" ? "Voir la file" : "View worklist" %> &rarr;
              </a>
            </div>
          </div>

          <%/* All payments today (all cashiers) */%>
          <div class="col-md-4">
            <div class="card shadow-sm h-100" style="border-left:4px solid #198754;">
              <div class="card-body py-3">
                <div class="d-flex justify-content-between align-items-start">
                  <div>
                    <div class="lbl"><%= locale==="fr" ? "Paiements auj." : "Payments today" %></div>
                    <h2 class="mb-0 fw-bold" style="color:#198754;font-size:2.2rem;">
                      <%= typeof allPaidTodayCount !== "undefined" ? allPaidTodayCount : 0 %>
                    </h2>
                    <small class="text-muted" style="font-size:.72rem;">
                      <%= locale==="fr" ? "Tous caissiers" : "All cashiers" %>
                    </small>
                  </div>
                  <i class="fas fa-check-circle fa-2x opacity-50 mt-1" style="color:#198754;"></i>
                </div>
              </div>
              <a href="/billing/sales-report" class="card-footer text-center py-1 text-decoration-none text-muted"
                style="font-size:.72rem;background:rgba(25,135,84,.08);">
                <%= locale==="fr" ? "Rapport" : "Report" %> &rarr;
              </a>
            </div>
          </div>

          <%/* Today's new unpaid bills */%>
          <div class="col-md-4">
            <div class="card shadow-sm h-100" style="border-left:4px solid #fd7e14;">
              <div class="card-body py-3">
                <div class="d-flex justify-content-between align-items-start">
                  <div>
                    <div class="lbl"><%= locale==="fr" ? "Impayees auj." : "Unpaid today" %></div>
                    <h2 class="mb-0 fw-bold" style="color:#fd7e14;font-size:2.2rem;">
                      <%= typeof todayUnpaidCount !== "undefined" ? todayUnpaidCount : 0 %>
                    </h2>
                    <small class="text-muted" style="font-size:.72rem;">
                      <%= locale==="fr" ? "Nouvelles factures impayees" : "New unpaid bills" %>
                    </small>
                  </div>
                  <i class="fas fa-exclamation-circle fa-2x opacity-50 mt-1" style="color:#fd7e14;"></i>
                </div>
              </div>
              <div class="card-footer py-1" style="background:rgba(253,126,20,.08);"></div>
            </div>
          </div>

        </div>

        <%/* 7-day combined sales + unpaid chart — billing clerk and admin only */%>
        <% if ((isBillingStaff || isAdmin || isAppAdmin) &&
               typeof unpaidLast7 !== "undefined" && unpaidLast7.length > 0) { %>
          <div class="card shadow-sm mb-4">
            <div class="card-header py-2 d-flex justify-content-between align-items-center">
              <span class="fw-bold" style="font-size:.82rem;">
                <i class="fas fa-chart-bar me-2 text-primary"></i>
                <%= locale==="fr"
                  ? "Ventes et factures payees (mois en cours)"
                  : "Daily Collections & Paid Bills (current month)" %>
              </span>
              <div style="font-size:.70rem;color:#6c757d;">
                <span class="me-3">
                  <span style="display:inline-block;width:10px;height:10px;
                    background:rgba(13,110,253,.6);border-radius:2px;vertical-align:middle;"></span>
                  &nbsp;<%= locale==="fr" ? "Encaisse (FCFA)" : "Collected (FCFA)" %>
                </span>
                <span>
                  <span style="display:inline-block;width:14px;height:3px;
                    background:#198754;vertical-align:middle;border-radius:2px;"></span>
                  &nbsp;<%= locale==="fr" ? "Factures payees (nb)" : "Paid bills (count)" %>
                </span>
              </div>
            </div>
            <div class="card-body py-3" style="height:200px;position:relative;">
              <canvas id="salesUnpaidChart"></canvas>
            </div>
          </div>
          <script>
          (function() {
            var labels  = [<% unpaidLast7.forEach(function(d,i) {
              var p = d.date.split("-"); var lbl = p[1]+"-"+p[2];
            %>"<%= lbl %>"<% if(i<unpaidLast7.length-1){%>,<%} }); %>];
            var sales   = [<% if(typeof salesLast7!=="undefined"){
              salesLast7.forEach(function(d,i){
            %><%= Math.round(d.total) %><%if(i<salesLast7.length-1){%>,<%}})}; %>];
            var unpaid  = [<% unpaidLast7.forEach(function(d,i){
              %><%= d.count %><%if(i<unpaidLast7.length-1){%>,<%}}); %>];
            var ctx = document.getElementById('salesUnpaidChart');
            if (!ctx) return;
            new Chart(ctx, {
              data: {
                labels: labels,
                datasets: [
                  {
                    type: 'bar',
                    label: "<%= locale==="fr"?"Encaisse (FCFA)":"Collected (FCFA)" %>",
                    data:  sales,
                    backgroundColor: 'rgba(13,110,253,.55)',
                    borderColor: '#0d6efd',
                    borderWidth: 1,
                    yAxisID: 'ySales',
                    order: 2,
                  },
                  {
                    type: 'line',
                    label: "<%= locale==="fr"?"Factures payees":"Paid bills" %>",
                    data:  unpaid,
                    borderColor: '#198754',
                    backgroundColor: 'rgba(25,135,84,.12)',
                    borderWidth: 2,
                    pointRadius: 4,
                    pointBackgroundColor: '#198754',
                    fill: false,
                    tension: 0.3,
                    yAxisID: 'yUnpaid',
                    order: 1,
                  }
                ]
              },
              options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                plugins: {
                  legend: { display: false },
                  tooltip: {
                    callbacks: {
                      label: function(ctx) {
                        if (ctx.dataset.yAxisID === 'ySales') {
                          return ' ' + Math.round(ctx.parsed.y).toLocaleString('fr-FR') + ' FCFA';
                        }
                        return ' ' + ctx.parsed.y +
                          " <%= locale==="fr"?"facture(s) payee(s)":"paid bill(s)" %>";
                      }
                    }
                  }
                },
                scales: {
                  ySales: {
                    type: 'linear', position: 'left',
                    beginAtZero: true,
                    ticks: {
                      font: { size: 10 },
                      callback: function(v) {
                        return v >= 1000
                          ? (v/1000).toLocaleString('fr-FR') + 'k'
                          : v.toLocaleString('fr-FR');
                      }
                    },
                    grid: { color: 'rgba(0,0,0,.04)' },
                  },
                  yUnpaid: {
                    type: 'linear', position: 'right',
                    beginAtZero: true,
                    ticks: { font: { size: 10 }, stepSize: 1 },
                    grid: { drawOnChartArea: false },
                  },
                  x: { ticks: { font: { size: 10 } } }
                }
              }
            });
          })();
          </script>
        <% } %>

        <%/* Open bills embedded table for billing staff */%>
        <%- include("partials/open_bills_table", {
              enrichedOpenBills: enrichedOpenBills,
              locale: locale,
              hasAnyPermission: hasAnyPermission
            }) %>

      <%/* ══════════════════════════════════════════════════════════
           ADMIN / APPAMDIN DASHBOARD
      ══════════════════════════════════════════════════════════ */%>
      <% } else if (isAdmin || isAppAdmin) { %>

        <%/* Encounter queue cards */%>
        <h6 class="fw-bold text-uppercase text-muted mb-2" style="font-size:.72rem;letter-spacing:.08em;">
          <i class="fas fa-stethoscope me-1"></i>
          <%= locale==="fr" ? "File des consultations" : "Consultation Queue" %>
        </h6>
        <div class="row g-3 mb-4">
          <div class="col-md-3">
            <div class="card shadow-sm h-100" style="border-left:4px solid #ffc107;">
              <div class="card-body py-3">
                <div class="d-flex justify-content-between align-items-start">
                  <div>
                    <div class="lbl"><%= locale==="fr" ? "File Département" : "Dept. Queue" %></div>
                    <h2 class="mb-0 fw-bold" style="color:#ffc107;font-size:2.2rem;">
                      <%= typeof pendingEncountersCount !== "undefined" ? pendingEncountersCount : 0 %>
                    </h2>
                    <small class="text-muted" style="font-size:.72rem;">
                      <%= locale==="fr" ? "En attente / Actifs" : "Pending / Active" %>
                    </small>
                  </div>
                  <i class="fas fa-users fa-2x text-warning opacity-50 mt-1"></i>
                </div>
              </div>
              <a href="/encounters/worklist?tab=dept"
                class="card-footer text-center py-1 text-decoration-none text-muted"
                style="font-size:.72rem;background:rgba(255,193,7,.1);">
                <%= locale==="fr" ? "Voir la file" : "View worklist" %> &rarr;
              </a>
            </div>
          </div>
          <div class="col-md-3">
            <div class="card shadow-sm h-100" style="border-left:4px solid #0d6efd;">
              <div class="card-body py-3">
                <div class="d-flex justify-content-between align-items-start">
                  <div>
                    <div class="lbl"><%= locale==="fr" ? "Mes patients" : "My Patients" %></div>
                    <h2 class="mb-0 fw-bold" style="color:#0d6efd;font-size:2.2rem;">
                      <%= typeof myEncountersCount !== "undefined" ? myEncountersCount : 0 %>
                    </h2>
                    <small class="text-muted" style="font-size:.72rem;">
                      <%= locale==="fr" ? "Assignés à moi" : "Assigned to me" %>
                    </small>
                  </div>
                  <i class="fas fa-user-md fa-2x text-primary opacity-50 mt-1"></i>
                </div>
              </div>
              <a href="/encounters/worklist?tab=mine"
                class="card-footer text-center py-1 text-decoration-none text-muted"
                style="font-size:.72rem;background:rgba(13,110,253,.08);">
                <%= locale==="fr" ? "Mes consultations" : "My encounters" %> &rarr;
              </a>
            </div>
          </div>
          <div class="col-md-3">
            <div class="card shadow-sm h-100" style="border-left:4px solid #6f42c1;">
              <div class="card-body py-3">
                <div class="d-flex justify-content-between align-items-start">
                  <div>
                    <div class="lbl"><%= t.dash.activePrescript %></div>
                    <h2 class="mb-0 fw-bold" style="color:#6f42c1;font-size:2.2rem;">
                      <%= activePrescriptionsCount %>
                    </h2>
                    <small class="text-muted" style="font-size:.72rem;">
                      <%= t.dash.activePrescSub %>
                    </small>
                  </div>
                  <i class="fas fa-pills fa-2x opacity-50 mt-1" style="color:#6f42c1;"></i>
                </div>
              </div>
              <div class="card-footer py-1" style="background:rgba(111,66,193,.08);"></div>
            </div>
          </div>
          <div class="col-md-3">
            <div class="card shadow-sm h-100" style="border-left:4px solid #dc3545;">
              <div class="card-body py-3">
                <div class="d-flex justify-content-between align-items-start">
                  <div>
                    <div class="lbl"><%= locale==="fr" ? "Factures ouvertes" : "Open Bills" %></div>
                    <h2 class="mb-0 fw-bold" style="color:#dc3545;font-size:2.2rem;">
                      <%= typeof openBillsCount !== "undefined" ? openBillsCount : 0 %>
                    </h2>
                    <small class="text-muted" style="font-size:.72rem;">
                      <%= locale==="fr" ? "En attente de paiement" : "Awaiting payment" %>
                    </small>
                  </div>
                  <i class="fas fa-file-invoice-dollar fa-2x opacity-50 mt-1" style="color:#dc3545;"></i>
                </div>
              </div>
              <a href="/billing/worklist"
                class="card-footer text-center py-1 text-decoration-none text-muted"
                style="font-size:.72rem;background:rgba(220,53,69,.08);">
                <%= locale==="fr" ? "Voir la file" : "View billing worklist" %> &rarr;
              </a>
            </div>
          </div>
        </div>

        <%/* Admin billing stats — same as billing clerk */%>
        <div class="row g-3 mb-4">
          <div class="col-md-4">
            <div class="card shadow-sm h-100" style="border-left:4px solid #198754;">
              <div class="card-body py-3">
                <div class="d-flex justify-content-between align-items-start">
                  <div>
                    <div class="lbl"><%= locale==="fr" ? "Paiements auj." : "Payments today" %></div>
                    <h2 class="mb-0 fw-bold" style="color:#198754;font-size:2.2rem;">
                      <%= typeof allPaidTodayCount !== "undefined" ? allPaidTodayCount : 0 %>
                    </h2>
                    <small class="text-muted" style="font-size:.72rem;">
                      <%= locale==="fr" ? "Tous caissiers" : "All cashiers" %>
                    </small>
                  </div>
                  <i class="fas fa-check-circle fa-2x opacity-50 mt-1" style="color:#198754;"></i>
                </div>
              </div>
              <a href="/billing/sales-report" class="card-footer text-center py-1 text-decoration-none text-muted"
                style="font-size:.72rem;background:rgba(25,135,84,.08);">
                <%= locale==="fr" ? "Rapport" : "Report" %> &rarr;
              </a>
            </div>
          </div>
          <div class="col-md-4">
            <div class="card shadow-sm h-100" style="border-left:4px solid #fd7e14;">
              <div class="card-body py-3">
                <div class="d-flex justify-content-between align-items-start">
                  <div>
                    <div class="lbl"><%= locale==="fr" ? "Impayees auj." : "Unpaid today" %></div>
                    <h2 class="mb-0 fw-bold" style="color:#fd7e14;font-size:2.2rem;">
                      <%= typeof todayUnpaidCount !== "undefined" ? todayUnpaidCount : 0 %>
                    </h2>
                    <small class="text-muted" style="font-size:.72rem;">
                      <%= locale==="fr" ? "Nouvelles impayees" : "New unpaid bills" %>
                    </small>
                  </div>
                  <i class="fas fa-exclamation-circle fa-2x opacity-50 mt-1" style="color:#fd7e14;"></i>
                </div>
              </div>
              <div class="card-footer py-1" style="background:rgba(253,126,20,.08);"></div>
            </div>
          </div>
          <div class="col-md-4">
            <div class="card text-white bg-dark shadow-sm h-100">
              <div class="card-body py-3">
                <div class="d-flex justify-content-between align-items-center">
                  <div>
