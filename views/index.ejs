<style>
  
  .card { background-color: #fff !important; }
  .list-group-item { font-size:.88rem; }
  .list-group-item:hover { background-color:#e9ecef; }
  .lbl { font-size:.68rem; font-weight:700; text-transform:uppercase;
         letter-spacing:.06em; color:#6c757d; }
  .quick-action-btn {
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    gap: 8px; padding: 18px 12px; line-height: 1.2;
  }
  .quick-action-btn i    { display: block; }
  .quick-action-btn span { font-size: .82rem; display: block; text-align: center; }
  tbody tr:nth-child(odd) > td,
  tbody tr:nth-child(odd) > th  { background-color: #f0f4ff !important; }
  tbody tr:nth-child(even) > td,
