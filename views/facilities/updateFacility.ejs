
<%- include("../partials/header", { title: t.facilities.updateTitle }) %>
<%- include("../partials/navbar") %>

<style>
  

  .form-wrapper { max-width: 860px; margin: 0 auto; }
  .form-label   { font-size: 0.75rem; font-weight: 600; margin-bottom: 2px; }
  .form-control, .form-select { font-size: 0.8rem; padding: 0.3rem 0.5rem; }
  .section-title { font-size: 0.7rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: .07em; color: #6c757d; border-bottom: 1px solid #dee2e6;
    padding-bottom: 3px; margin-bottom: 8px; }
</style>

<div class="container-fluid py-3 px-4 content-wrapper">
  <div class="card shadow-sm form-wrapper">
    <div class="card-header bg-primary text-white py-2">
      <h6 class="mb-0"><i class="fas fa-hospital me-2"></i><%= t.facilities.updateTitle %></h6>
    </div>
    <div class="card-body p-3">

      <% if (typeof success !== "undefined" && success) { %>
        <div class="alert alert-success py-2 mb-2" style="font-size:0.8rem;"><%= t.facilities.successUpdate %></div>
      <% } %>
      <% if (typeof errors !== "undefined" && errors.length > 0) { %>
        <div class="alert alert-danger py-2 mb-2" style="font-size:0.8rem;">
          <ul class="mb-0"><% errors.forEach(e => { %><li><%= e %></li><% }) %></ul>
        </div>
      <% } %>

      <%/* ── Step 1: Select facility ── */%>
      <form method="GET" action="/admin/facilities/update" id="selectForm">
        <p class="section-title"><i class="fas fa-search me-1"></i><%= t.facilities.select %></p>
        <div class="row g-2 mb-3">
          <div class="col-md-8">
            <input type="text" id="facilitySearch" class="form-control form-control-sm mb-1"
              placeholder="<%= t.facilities.search %>">
            <select name="facility_id" id="facilitySelect" class="form-select form-select-sm" required size="4">
              <% if (typeof facilities !== "undefined") { facilities.forEach(f => { %>
                <option value="<%= f.id %>"
                  <%= typeof facility !== "undefined" && facility && String(f.id) === String(facility.id) ? "selected" : "" %>>
                  <%= f.name %> (<%= f.code %>)
                </option>
              <% }) } %>
            </select>
          </div>
          <div class="col-md-4 d-flex flex-column justify-content-end gap-1">
            <button type="submit" class="btn btn-sm btn-primary">
              <i class="fas fa-download me-1"></i><%= t.facilities.load %>
            </button>
            <a href="/" class="btn btn-sm btn-outline-secondary"><%= t.common.cancel %></a>
          </div>
        </div>
      </form>

      <% if (typeof facility !== "undefined" && facility) { %>
      <hr class="my-2">

      <%/* ── Step 2: Edit facility ── */%>
      <p class="mb-2" style="font-size:0.78rem;">
        <i class="fas fa-hospital me-1 text-primary"></i>
        <%= t.facilities.edit %> <strong class="text-primary"><%= facility.name %></strong>
      </p>

      <form action="/admin/facilities/update" method="POST">
        <input type="hidden" name="facility_id" value="<%= facility.id %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <p class="section-title"><i class="fas fa-info-circle me-1"></i><%= locale === "fr" ? "Identification" : "Identification" %></p>
        <div class="row g-2 mb-3">
          <div class="col-md-5">
            <label class="form-label"><%= t.facilities.name %> <span class="text-danger">*</span></label>
            <input type="text" name="name" class="form-control form-control-sm" value="<%= facility.name %>" required>
          </div>
          <div class="col-md-2">
            <label class="form-label"><%= t.facilities.code %> <span class="text-danger">*</span></label>
            <input type="text" name="code" class="form-control form-control-sm" value="<%= facility.code %>" maxlength="10" required>
          </div>
          <div class="col-md-3">
            <label class="form-label"><%= t.facilities.type %> <span class="text-danger">*</span></label>
            <select name="type" class="form-select form-select-sm" required>
              <option value=""><%= t.facilities.selectType %></option>
              <option value="Hospital"      <%= facility.type === "Hospital"      ? "selected" : "" %>><%= t.facilities.hospital %></option>
              <option value="Health Center" <%= facility.type === "Health Center" ? "selected" : "" %>><%= t.facilities.healthCenter %></option>
              <option value="Clinic"        <%= facility.type === "Clinic"        ? "selected" : "" %>><%= t.facilities.clinic %></option>
            </select>
          </div>
          <div class="col-md-2">
            <label class="form-label"><%= t.facilities.facilityType %></label>
            <select id="facility-type" name="facility_type" class="form-select form-select-sm">
              <option value="main"      <%= !facility.parent_id || facility.parent_id === facility.id ? "selected" : "" %>><%= t.facilities.main %></option>
              <option value="satellite" <%= facility.parent_id && facility.parent_id !== facility.id  ? "selected" : "" %>><%= t.facilities.satellite %></option>
            </select>
          </div>
        </div>

        <div class="row g-2 mb-3" id="parent-facility-field" style="display:none;">
          <div class="col-md-6">
            <label class="form-label"><%= t.facilities.parent %> <span class="text-danger">*</span></label>
            <select name="parent_id" class="form-select form-select-sm">
              <option value=""><%= t.facilities.selectParent %></option>
              <% if (typeof mainFacilities !== "undefined") { mainFacilities.forEach(f => { %>
                <option value="<%= f.id %>" <%= facility.parent_id && String(facility.parent_id) === String(f.id) ? "selected" : "" %>><%= f.name %></option>
              <% }) } %>
            </select>
          </div>
        </div>

        <p class="section-title"><i class="fas fa-users me-1"></i><%= locale === "fr" ? "Responsables" : "Responsible Staff" %></p>
        <div class="row g-2 mb-3">
          <div class="col-md-4">
            <label class="form-label"><%= t.facilities.director %></label>
            <select name="director_id" class="form-select form-select-sm">
              <option value=""><%= t.facilities.selectStaff %></option>
              <% if (typeof staff !== "undefined") { staff.forEach(s => { %>
                <option value="<%= s.nr %>" <%= String(facility.director_id) === String(s.nr) ? "selected" : "" %>>
                  <%= s.person ? s.person.name_first + " " + s.person.name_last : (s.job_function_title || s.nr) %>
                </option>
              <% }) } %>
            </select>
          </div>
          <div class="col-md-4">
            <label class="form-label"><%= t.facilities.headNurse %></label>
            <select name="head_nurse_id" class="form-select form-select-sm">
              <option value=""><%= t.facilities.selectStaff %></option>
              <% if (typeof staff !== "undefined") { staff.forEach(s => { %>
                <option value="<%= s.nr %>" <%= String(facility.head_nurse_id) === String(s.nr) ? "selected" : "" %>>
                  <%= s.person ? s.person.name_first + " " + s.person.name_last : (s.job_function_title || s.nr) %>
                </option>
              <% }) } %>
            </select>
          </div>
          <div class="col-md-4">
            <label class="form-label"><%= t.facilities.financeOfficer %></label>
            <select name="finance_officer_id" class="form-select form-select-sm">
              <option value=""><%= t.facilities.selectStaff %></option>
              <% if (typeof staff !== "undefined") { staff.forEach(s => { %>
                <option value="<%= s.nr %>" <%= String(facility.finance_officer_id) === String(s.nr) ? "selected" : "" %>>
                  <%= s.person ? s.person.name_first + " " + s.person.name_last : (s.job_function_title || s.nr) %>
                </option>
              <% }) } %>
            </select>
          </div>
        </div>

        <p class="section-title"><i class="fas fa-map-marker-alt me-1"></i><%= locale === "fr" ? "Localisation" : "Location" %></p>
        <div class="row g-2 mb-3">
          <div class="col-md-4">
            <label class="form-label"><%= t.facilities.address %></label>
            <input type="text" name="address" class="form-control form-control-sm" value="<%= facility.address || "" %>">
          </div>
          <div class="col-md-3">
            <label class="form-label"><%= t.facilities.city %></label>
            <input type="text" name="city" class="form-control form-control-sm" value="<%= facility.city || "" %>">
          </div>
          <div class="col-md-2">
            <label class="form-label"><%= t.facilities.region %></label>
            <input type="text" name="region" class="form-control form-control-sm" value="<%= facility.region || "" %>">
          </div>
          <div class="col-md-3">
            <label class="form-label"><%= t.facilities.country %></label>
            <input type="text" name="country" class="form-control form-control-sm" value="<%= facility.country || "Cameroon" %>">
          </div>
        </div>

        <div class="text-end mt-2 pt-2 border-top">
          <button type="submit" class="btn btn-sm btn-success">
            <i class="fas fa-save me-1"></i><%= t.facilities.update %>
          </button>
        </div>
      </form>

      <%# System Configuration — department assignment. Departments stay a
          single global catalog (care_department); this just records which
          ones are active at this specific facility, via
          care_facility_departments. Unchecking soft-deactivates rather
          than deleting the row. %>
      <div class="card mt-3">
        <div class="card-header bg-secondary text-white py-2">
          <i class="fas fa-building me-2"></i>
          <%= locale==="fr" ? "Departements de l'etablissement" : "Facility Departments" %>
        </div>
        <div class="card-body">
          <% if (typeof allDepartments !== "undefined" && allDepartments.length > 0) { %>
            <form action="/admin/facilities/update-departments" method="POST">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="facility_id" value="<%= facility.id %>">
              <div class="row g-2">
                <% allDepartments.forEach(function(dept) { %>
                  <div class="col-md-4 col-sm-6">
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox"
                        name="dept_nrs" value="<%= dept.nr %>"
                        id="dept-<%= dept.nr %>"
                        <%= (typeof activeDeptNrs !== "undefined" && activeDeptNrs.has(dept.nr)) ? "checked" : "" %>>
                      <label class="form-check-label" for="dept-<%= dept.nr %>" style="font-size:.85rem;">
                        <%= dept.name_formal || dept.name_short %>
                      </label>
                    </div>
                  </div>
                <% }); %>
              </div>
              <div class="text-end mt-3 pt-2 border-top">
                <button type="submit" class="btn btn-sm btn-success">
                  <i class="fas fa-save me-1"></i>
                  <%= locale==="fr" ? "Enregistrer les departements" : "Save Departments" %>
                </button>
              </div>
            </form>
          <% } else { %>
            <div class="text-muted text-center py-3" style="font-size:.85rem;">
              <%= locale==="fr" ? "Aucun departement disponible." : "No departments available." %>
            </div>
          <% } %>
        </div>
      </div>
      <% } %>

    </div>
  </div>
</div>

<script>
document.getElementById('facilitySearch').addEventListener('input', function() {
  const s = this.value.toLowerCase();
  document.querySelectorAll('#facilitySelect option').forEach(o => {
    o.style.display = o.textContent.toLowerCase().includes(s) ? '' : 'none';
  });
});

document.addEventListener('DOMContentLoaded', function() {
  const typeSelect  = document.getElementById('facility-type');
  if (!typeSelect) return;
  const parentField = document.getElementById('parent-facility-field');
  const parentSel   = parentField ? parentField.querySelector('select[name="parent_id"]') : null;

  const toggle = () => {
    const isSat = typeSelect.value === 'satellite';
    if (parentField) parentField.style.display = isSat ? 'flex' : 'none';
    if (parentSel) {
      isSat ? parentSel.setAttribute('required','required') : parentSel.removeAttribute('required');
    }
  };
  typeSelect.addEventListener('change', toggle);
  toggle();
});
</script>

<%- include("../partials/footer") %>




