
<%- include("../partials/header", { title: title }) %>

<style>
  
  .receipt-wrap { max-width: 420px; margin: 30px auto; padding: 24px;
                  border: 1px solid #dee2e6; border-radius: 8px; }
  .receipt-header { text-align: center; border-bottom: 2px dashed #dee2e6;
                    padding-bottom: 12px; margin-bottom: 14px; }
  .receipt-header h4 { margin: 0 0 4px; font-size: 1.1rem; }
  .receipt-header small { color: #6c757d; font-size: .78rem; }
  .receipt-row { display: flex; justify-content: space-between;
                 font-size: .82rem; padding: 3px 0; }
  .receipt-row.divider { border-top: 1px dashed #dee2e6; margin-top: 6px; padding-top: 6px; }
  .receipt-row.total   { font-weight: 700; font-size: .95rem; margin-top: 4px; }
  .receipt-footer { text-align: center; border-top: 2px dashed #dee2e6;
                    margin-top: 14px; padding-top: 12px;
                    font-size: .76rem; color: #6c757d; }
  .item-list { margin: 10px 0; }
  .item-line { font-size: .78rem; padding: 2px 0; border-bottom: 1px dotted #f0f0f0; }
  @media print {
    .no-print { display: none !important; }
    body { margin: 0; }
    .receipt-wrap { border: none; margin: 0; max-width: 100%; }
  }
</style>

<div class="receipt-wrap">
  <%- include("../partials/documentHeader", { facility: facility }) %>
  <div class="receipt-header" style="border-bottom:none; padding-bottom:0; margin-bottom:10px;">
    <small><%= locale==="fr"?"RECU DE PAIEMENT":"PAYMENT RECEIPT" %></small><br>
    <small>#<%= payment.payment_id %></small>
  </div>

  <%/* Patient & bill info */%>
  <div class="receipt-row">
    <span>Patient:</span>
    <span class="fw-bold">
      <%= patient ? patient.name_last + " " + patient.name_first : "-" %>
    </span>
  </div>
  <div class="receipt-row">
    <span><%= locale==="fr"?"N° Dossier:":"File No.:" %></span>
    <span><%= patient ? patient.hospital_file_nr : "-" %></span>
  </div>
  <div class="receipt-row">
    <span><%= locale==="fr"?"Facture:":"Bill:" %></span>
    <span>#<%= payment.bill_no %></span>
  </div>
  <div class="receipt-row">
    <span><%= locale==="fr"?"Consultation:":"Encounter:" %></span>
    <span>#<%= payment.payment_encounter_nr %></span>
  </div>
  <div class="receipt-row">
    <span>Date:</span>
    <span>
      <%= payment.payment_date
        ? new Date(payment.payment_date).toLocaleString(locale==="fr"?"fr-FR":"en-GB",
            { day:"2-digit", month:"2-digit", year:"numeric",
              hour:"2-digit", minute:"2-digit" })
        : "-" %>
    </span>
  </div>

  <%/* Items paid in this payment */%>
  <div class="item-list">
    <div style="font-size:.72rem;font-weight:700;text-transform:uppercase;
                color:#6c757d;margin:10px 0 4px;">
      <%= locale==="fr"?"Articles payes:":"Items paid:" %>
    </div>
    <% var itemTotal = 0; %>
    <% items.forEach(function(item) { %>
      <% itemTotal += item.amount || 0; %>
      <div class="item-line d-flex justify-content-between">
        <span><%= item.article %><% if (item.units > 1) { %> x<%= item.units %><% } %></span>
        <span><%= (item.amount||0).toLocaleString("fr-FR") %> FCFA</span>
      </div>
    <% }); %>
  </div>

  <div class="receipt-row divider total">
    <span>TOTAL:</span>
    <span><%= itemTotal.toLocaleString("fr-FR") %> FCFA</span>
  </div>

  <div class="receipt-row" style="margin-top:6px;">
    <span><%= locale==="fr"?"Mode de paiement:":"Payment mode:" %></span>
    <span class="fw-bold" style="text-transform:uppercase;">
      <%= payment.payment_mode %>
    </span>
  </div>
  <div class="receipt-row">
    <span><%= locale==="fr"?"Encaisse par:":"Received by:" %></span>
    <span><%= payment.received_by %></span>
  </div>

  <div class="receipt-footer">
    <%= locale==="fr"
      ? "Merci pour votre paiement. Conservez ce recu."
      : "Thank you for your payment. Please keep this receipt." %>
    <br>
    <strong><%= new Date().toLocaleDateString(locale==="fr"?"fr-FR":"en-GB") %></strong>
  </div>
</div>

<div class="text-center mt-3 no-print">
  <button class="btn btn-primary btn-sm me-2" onclick="window.print()">
    <i class="fas fa-print me-1"></i>
    <%= locale==="fr"?"Imprimer":"Print" %>
  </button>
  <button class="btn btn-outline-secondary btn-sm" onclick="window.close()">
    <i class="fas fa-times me-1"></i>
    <%= locale==="fr"?"Fermer":"Close" %>
  </button>
</div>



<%- include("../partials/footer") %>










