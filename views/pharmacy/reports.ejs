<%- include("../partials/header", { title: title }) %>
<%- include("../partials/navbar", { activePage: "pharmacy", user: user }) %>
<style>
  .content-wrapper { background-color: #f0f2f5; }
  .card { background:#fff !important; }
  .ph-header { background:linear-gradient(135deg,#1a9e72 0%,#157a58 100%); color:#fff; border-radius:.5rem .5rem 0 0; }
  .ph-tab-active   { background:#1a9e72 !important; color:#fff !important; border-color:#1a9e72 !important; }
  .ph-tab-inactive { background:#e8f5f0; color:#1a9e72; border:1px solid #b2dfce; }
  .ph-tab-inactive:hover { background:#d1ece3; }
  .stat-box { background:#fff; border-radius:.5rem; border:1px solid #dee2e6; padding:14px 16px; text-align:center; box-shadow:0 1px 4px rgba(0,0,0,.07); }
  .stat-val { font-size:1.5rem; font-weight:800; line-height:1; }
  .stat-lbl { font-size:.68rem; text-transform:uppercase; letter-spacing:.05em; color:#6c757d; font-weight:600; margin-top:4px; }
  .table-xs td,.table-xs th { padding:5px 9px; font-size:.79rem; }
  .btn-xs { padding:2px 7px; font-size:.70rem; }
  .lbl { font-size:.68rem; font-weight:700; text-transform:uppercase; letter-spacing:.06em; color:#6c757d; }
  .stock-ok   { display:inline-block; padding:2px 7px; border-radius:10px; background:#d1ece3; color:#0a3622; font-size:.62rem; font-weight:700; }
  .stock-low  { display:inline-block; padding:2px 7px; border-radius:10px; background:#fff3cd; color:#856404; font-size:.62rem; font-weight:700; }
  .stock-out  { display:inline-block; padding:2px 7px; border-radius:10px; background:#f8d7da; color:#842029; font-size:.62rem; font-weight:700; }
  .badge-med { background:#1a9e72; color:#fff; font-size:.60rem; padding:2px 6px; border-radius:4px; }
  .badge-sup { background:#0d6efd; color:#fff; font-size:.60rem; padding:2px 6px; border-radius:4px; }
  tbody tr:nth-child(odd) > td,
  tbody tr:nth-child(odd) > th  { background-color: #f0f4ff !important; }
  tbody tr:nth-child(even) > td,
  tbody tr:nth-child(even) > th { background-color: #ffffff !important; }
  tbody tr:hover > td,
  tbody tr:hover > th           { background-color: #dce8ff !important; }
</style>
<div class="container-fluid py-3 px-4 content-wrapper">

  <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h5 class="mb-0 fw-bold">
      <i class="fas fa-chart-bar me-2" style="color:#6f42c1;"></i>
      <%= locale==="fr"?"Rapports pharmacie":"Pharmacy Reports" %>
    </h5>
    <div class="d-flex gap-2">
      <a href="/pharmacy/reports?print=1&date_from=<%= dateFrom %>&date_to=<%= dateTo %><%= agentFilter?"&agent="+agentFilter:"" %>"
         target="_blank" class="btn btn-xs btn-outline-primary">
        <i class="fas fa-print me-1"></i><%= locale==="fr"?"Imprimer":"Print" %>
      </a>
      <a href="/pharmacy" class="btn btn-xs btn-outline-secondary">
        <i class="fas fa-arrow-left me-1"></i>Dashboard
      </a>
    </div>
  </div>

  <div class="card shadow-sm mb-3"><div class="card-body py-2 px-3">
    <form method="GET" action="/pharmacy/reports" class="d-flex gap-2 flex-wrap align-items-end">
      <div><label class="lbl"><%= locale==="fr"?"Du":"From" %></label>
        <input type="date" name="date_from" value="<%= dateFrom %>" class="form-control form-control-sm"></div>
      <div><label class="lbl"><%= locale==="fr"?"Au":"To" %></label>
        <input type="date" name="date_to" value="<%= dateTo %>" class="form-control form-control-sm"></div>
      <% if (isSup) { %>
        <div><label class="lbl"><%= locale==="fr"?"Agent":"Agent" %></label>
          <select name="agent" class="form-select form-select-sm">
            <option value=""><%= locale==="fr"?"Tous les agents":"All agents" %></option>
            <% agents.forEach(function(a){ %>
              <option value="<%= a.dispensed_by %>" <%= agentFilter===a.dispensed_by?"selected":"" %>><%= a.dispensed_by %></option>
            <% }); %>
          </select>
        </div>
      <% } %>
      <button type="submit" class="btn btn-sm" style="background:#1a9e72;color:#fff;"><i class="fas fa-filter"></i></button>
    </form>
  </div></div>

  <div class="row g-3 mb-3">
    <div class="col-md-3"><div class="stat-box"><div class="stat-val" style="color:#1a9e72;"><%= dispensings.length %></div><div class="stat-lbl"><%= locale==="fr"?"Distributions":"Dispensings" %></div></div></div>
    <div class="col-md-3"><div class="stat-box"><div class="stat-val" style="color:#0d6efd;"><%= dispensings.reduce(function(s,d){return s+d.qty_dispensed;},0) %></div><div class="stat-lbl"><%= locale==="fr"?"Unites totales":"Total Units" %></div></div></div>
    <div class="col-md-3"><div class="stat-box"><div class="stat-val" style="color:#6f42c1;"><%= byArticle.length %></div><div class="stat-lbl"><%= locale==="fr"?"Articles distincts":"Distinct Items" %></div></div></div>
    <% if (isSup) { %>
      <div class="col-md-3"><div class="stat-box"><div class="stat-val" style="color:#fd7e14;"><%= byAgent.length %></div><div class="stat-lbl"><%= locale==="fr"?"Agents actifs":"Active Agents" %></div></div></div>
    <% } %>
  </div>

  <div class="row g-3">
    <div class="col-lg-6">
      <div class="card shadow-sm">
        <div class="card-header py-2 fw-bold" style="background:#e8f5f0;font-size:.85rem;border-bottom:2px solid #1a9e72;">
          <i class="fas fa-pills me-2" style="color:#1a9e72;"></i>
          <%= locale==="fr"?"Par article":"By Article" %>
        </div>
        <div class="card-body p-0">
          <table class="table table-xs table-hover align-middle mb-0">
            <thead class="table-dark"><tr>
              <th><%= locale==="fr"?"Article":"Article" %></th>
              <th><%= locale==="fr"?"Code":"Code" %></th>
              <th class="text-center"><%= locale==="fr"?"Fois":"Count" %></th>
              <th class="text-center"><%= locale==="fr"?"Unites":"Units" %></th>
            </tr></thead>
            <tbody>
              <% if (!byArticle.length) { %>
                <tr><td colspan="4" class="text-center text-muted py-3"><%= locale==="fr"?"Aucune donnee.":"No data." %></td></tr>
              <% } else { byArticle.forEach(function(a){ %>
                <tr>
                  <td class="fw-bold" style="font-size:.77rem;"><%= a.article %></td>
                  <td><code style="font-size:.68rem;"><%= a.item_number %></code></td>
                  <td class="text-center"><%= a.count %></td>
                  <td class="text-center fw-bold" style="color:#1a9e72;"><%= a.total_dispensed %></td>
                </tr>
              <% }); } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <% if (isSup) { %>
    <div class="col-lg-6">
      <div class="card shadow-sm">
        <div class="card-header py-2 fw-bold" style="background:#f3eeff;font-size:.85rem;border-bottom:2px solid #6f42c1;">
          <i class="fas fa-users me-2" style="color:#6f42c1;"></i>
          <%= locale==="fr"?"Par agent":"By Agent" %>
        </div>
        <div class="card-body p-0">
          <table class="table table-xs table-hover align-middle mb-0">
            <thead class="table-dark"><tr>
              <th><%= locale==="fr"?"Agent":"Agent" %></th>
              <th class="text-center"><%= locale==="fr"?"Distributions":"Dispensings" %></th>
              <th class="text-center"><%= locale==="fr"?"Unites":"Units" %></th>
            </tr></thead>
            <tbody>
              <% byAgent.forEach(function(a){ %>
                <tr>
                  <td class="fw-bold" style="font-size:.78rem;"><%= a.agent %></td>
                  <td class="text-center"><%= a.count %></td>
                  <td class="text-center fw-bold" style="color:#6f42c1;"><%= a.total %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
    <% } %>
  </div>

  <div class="card shadow-sm mt-3">
    <div class="card-header py-2 fw-bold" style="background:#e8f0fe;font-size:.85rem;border-bottom:2px solid #0d6efd;">
      <i class="fas fa-list me-2" style="color:#0d6efd;"></i>
      <%= locale==="fr"?"Detail complet":"Full Detail" %>
      <span class="badge ms-1" style="background:#0d6efd;font-size:.60rem;"><%= dispensings.length %></span>
    </div>
    <div class="card-body p-0">
      <table class="table table-xs table-hover align-middle mb-0">
        <thead class="table-dark"><tr>
          <th><%= locale==="fr"?"Article":"Article" %></th>
          <th class="text-center">Qte</th>
          <th><%= locale==="fr"?"Facture":"Bill" %></th>
          <th><%= locale==="fr"?"Par":"By" %></th>
          <th><%= locale==="fr"?"Date":"Date" %></th>
        </tr></thead>
        <tbody>
          <% if (!dispensings.length) { %>
            <tr><td colspan="5" class="text-center text-muted py-3"><%= locale==="fr"?"Aucune distribution.":"No dispensings." %></td></tr>
          <% } else { dispensings.forEach(function(d){ %>
            <tr>
              <td class="fw-bold" style="font-size:.78rem;"><%= d.article %></td>
              <td class="text-center fw-bold" style="color:#1a9e72;"><%= d.qty_dispensed %></td>
              <td><a href="/pharmacy/dispense/<%= d.bill_no %>" style="color:#1a9e72;font-size:.74rem;">#<%= d.bill_no %></a></td>
              <td class="text-muted" style="font-size:.72rem;"><%= d.dispensed_by %></td>
              <td class="text-muted" style="font-size:.70rem;">
                <%= new Date(d.dispensed_at).toLocaleDateString(locale==="fr"?"fr-FR":"en-GB") %>
              </td>
            </tr>
          <% }); } %>
        </tbody>
      </table>
    </div>
  </div>

</div>
<%- include("../partials/footer") %>












