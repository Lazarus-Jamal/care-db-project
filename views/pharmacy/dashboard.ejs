<%- include("../partials/header", { title: title }) %>
<%- include("../partials/navbar", { activePage: "pharmacy", user: user }) %>
<style>
  .content-wrapper { background-color: #f0f2f5; }
  .card { background:#fff !important; }
  .ph-header { background:linear-gradient(135deg,#1a9e72 0%,#157a58 100%); color:#fff; border-radius:.5rem .5rem 0 0; }
  .ph-tab-active   { background:#1a9e72 !important; color:#fff !important; border-color:#1a9e72 !important; }
  .ph-tab-inactive { background:#e8f5f0; color:#1a9e72; border:1px solid #b2dfce; }
  .ph-tab-inactive:hover { background:#d1ece3; }
  .stat-box { background:#fff; border-radius:.5rem; border:1px solid #dee2e6; padding:14px 16px; text-align:center; box-shadow:0 1px 4px rgba(0,0,0,.07); }
  .stat-val { font-size:1.5rem; font-weight:800; line-height:1; }
  .stat-lbl { font-size:.68rem; text-transform:uppercase; letter-spacing:.05em; color:#6c757d; font-weight:600; margin-top:4px; }
  .table-xs td,.table-xs th { padding:5px 9px; font-size:.79rem; }
  .btn-xs { padding:2px 7px; font-size:.70rem; }
  .lbl { font-size:.68rem; font-weight:700; text-transform:uppercase; letter-spacing:.06em; color:#6c757d; }
  .stock-ok   { display:inline-block; padding:2px 7px; border-radius:10px; background:#d1ece3; color:#0a3622; font-size:.62rem; font-weight:700; }
  .stock-low  { display:inline-block; padding:2px 7px; border-radius:10px; background:#fff3cd; color:#856404; font-size:.62rem; font-weight:700; }
  .stock-out  { display:inline-block; padding:2px 7px; border-radius:10px; background:#f8d7da; color:#842029; font-size:.62rem; font-weight:700; }
  .badge-med { background:#1a9e72; color:#fff; font-size:.60rem; padding:2px 6px; border-radius:4px; }
  .badge-sup { background:#0d6efd; color:#fff; font-size:.60rem; padding:2px 6px; border-radius:4px; }
  tbody tr:nth-child(odd) > td,
  tbody tr:nth-child(odd) > th  { background-color: #f0f4ff !important; }
  tbody tr:nth-child(even) > td,
  tbody tr:nth-child(even) > th { background-color: #ffffff !important; }
  tbody tr:hover > td,
  tbody tr:hover > th           { background-color: #dce8ff !important; }
</style>
<div class="container-fluid py-3 px-4 content-wrapper">

  <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
      <h5 class="mb-0 fw-bold">
        <i class="fas fa-tachometer-alt me-2" style="color:#1a9e72;"></i>
        <%= locale==="fr"?"Pharmacie — Tableau de bord":"Pharmacy — Dashboard" %>
      </h5>
      <small class="text-muted">
        <%= isSup
          ? (locale==="fr"?"Vue superviseur — toutes les activites":"Supervisor view — all activity")
          : (locale==="fr"?"Mes activites":"My activity") %>
      </small>
    </div>
    <% if (typeof hasPermission !== "undefined" && hasPermission("Pharmacy.Dispense.Medication")) { %>
      <a href="/pharmacy/dispense" class="btn btn-sm" style="background:#1a9e72;color:#fff;">
        <i class="fas fa-hand-holding-medical me-1"></i>
        <%= locale==="fr"?"File de distribution":"Dispensing Queue" %>
        <% if (pendingCount > 0) { %>
          <span class="badge bg-light text-dark ms-1"><%= pendingCount %></span>
        <% } %>
      </a>
    <% } %>
  </div>

  <%/* Stats row */%>
  <div class="row g-3 mb-4">
    <% var stats = [
      { val: pendingCount,   lbl: locale==="fr"?"En attente distribution":"Pending Dispense", col:"#dc3545", icon:"fa-clock" },
      { val: todayDispensed, lbl: locale==="fr"?"Distribues aujourd hui":"Dispensed Today",   col:"#1a9e72", icon:"fa-check-circle" },
      { val: monthDispensed, lbl: locale==="fr"?"Ce mois-ci":"This Month",                    col:"#0d6efd", icon:"fa-calendar" },
      { val: pendingOrders,  lbl: locale==="fr"?"Commandes entrepot":"Warehouse Orders",       col:"#fd7e14", icon:"fa-truck" },
      { val: lowStock,       lbl: locale==="fr"?"Stock bas":"Low Stock",                       col:"#856404", icon:"fa-exclamation-triangle" },
      { val: outOfStock,     lbl: locale==="fr"?"Rupture de stock":"Out of Stock",             col:"#842029", icon:"fa-times-circle" },
    ]; %>
    <% stats.forEach(function(s){ %>
      <div class="col-6 col-md-2">
        <div class="stat-box">
          <div class="stat-val" style="color:<%= s.col %>;"><%= s.val %></div>
          <div class="stat-lbl"><i class="fas <%= s.icon %> me-1"></i><%= s.lbl %></div>
        </div>
      </div>
    <% }); %>
  </div>

  <div class="row g-3">
    <%/* Recent activity */%>
    <div class="col-lg-8">
      <div class="card shadow-sm">
        <div class="ph-header px-3 py-2 d-flex justify-content-between align-items-center">
          <span class="fw-bold" style="font-size:.85rem;">
            <i class="fas fa-history me-2"></i>
            <%= locale==="fr"?"Distributions recentes":"Recent Dispensings" %>
          </span>
          <a href="/pharmacy/reports" class="btn btn-xs" style="background:rgba(255,255,255,.2);color:#fff;border:1px solid rgba(255,255,255,.3);">
            <%= locale==="fr"?"Voir tout":"View all" %>
          </a>
        </div>
        <div class="card-body p-0">
          <% if (!recentDispensings || recentDispensings.length === 0) { %>
            <div class="text-center text-muted py-4" style="font-size:.82rem;">
              <i class="fas fa-inbox fa-2x mb-2 d-block opacity-25"></i>
              <%= locale==="fr"?"Aucune distribution recente.":"No recent dispensings." %>
            </div>
          <% } else { %>
            <table class="table table-xs table-hover align-middle mb-0">
              <thead class="table-dark"><tr>
                <th><%= locale==="fr"?"Article":"Article" %></th>
                <th class="text-center">Qte</th>
                <th><%= locale==="fr"?"Facture":"Bill" %></th>
                <% if (isSup) { %><th><%= locale==="fr"?"Agent":"Agent" %></th><% } %>
                <th><%= locale==="fr"?"Heure":"Time" %></th>
              </tr></thead>
              <tbody>
                <% recentDispensings.forEach(function(d){ %>
                  <tr>
                    <td class="fw-bold" style="font-size:.76rem;"><%= d.article %></td>
                    <td class="text-center"><span style="color:#1a9e72;font-weight:700;"><%= d.qty_dispensed %></span></td>
                    <td><a href="/pharmacy/dispense/<%= d.bill_no %>" class="text-decoration-none" style="font-size:.74rem;">#<%= d.bill_no %></a></td>
                    <% if (isSup) { %><td class="text-muted" style="font-size:.72rem;"><%= d.dispensed_by %></td><% } %>
                    <td class="text-muted" style="font-size:.70rem;">
                      <%= new Date(d.dispensed_at).toLocaleTimeString(locale==="fr"?"fr-FR":"en-GB",{hour:"2-digit",minute:"2-digit"}) %>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          <% } %>
        </div>
      </div>
    </div>

    <%/* Quick links */%>
    <div class="col-lg-4">
      <div class="card shadow-sm">
        <div class="ph-header px-3 py-2">
          <span class="fw-bold" style="font-size:.85rem;">
            <i class="fas fa-bolt me-2"></i><%= locale==="fr"?"Acces rapide":"Quick Access" %>
          </span>
        </div>
        <div class="card-body p-2 d-flex flex-column gap-2">
          <a href="/pharmacy/dispense" class="btn btn-sm text-start" style="background:#fce8e8;color:#842029;border:1px solid #f5c6cb;">
            <i class="fas fa-hand-holding-medical me-2"></i>
            <%= locale==="fr"?"File de distribution":"Dispensing Queue" %>
            <% if (pendingCount > 0) { %><span class="badge bg-danger ms-1"><%= pendingCount %></span><% } %>
          </a>
          <a href="/pharmacy/stock" class="btn btn-sm text-start" style="background:#e8f5f0;color:#157a58;border:1px solid #b2dfce;">
            <i class="fas fa-boxes me-2"></i><%= locale==="fr"?"Stock pharmacie":"Pharmacy Stock" %>
          </a>
          <a href="/pharmacy/orders" class="btn btn-sm text-start" style="background:#e8f0fe;color:#1a56b0;border:1px solid #c9d8fb;">
            <i class="fas fa-truck me-2"></i><%= locale==="fr"?"Commandes entrepot":"Warehouse Orders" %>
            <% if (pendingOrders > 0) { %><span class="badge bg-warning text-dark ms-1"><%= pendingOrders %></span><% } %>
          </a>
          <% if (typeof hasPermission !== "undefined" && hasPermission("Pharmacy.Inventory.Count")) { %>
            <a href="/pharmacy/inventory-count" class="btn btn-sm text-start" style="background:#f3eeff;color:#5a2d82;border:1px solid #d8c4f8;">
              <i class="fas fa-clipboard-list me-2"></i><%= locale==="fr"?"Comptage inventaire":"Inventory Count" %>
            </a>
          <% } %>
          <% if (typeof hasPermission !== "undefined" && hasPermission("Pharmacy.View.Reports")) { %>
            <a href="/pharmacy/reports" class="btn btn-sm text-start" style="background:#f0ebff;color:#5a2d82;border:1px solid #d8c4f8;">
              <i class="fas fa-chart-bar me-2"></i><%= locale==="fr"?"Rapports":"Reports" %>
            </a>
          <% } %>
        </div>
      </div>
      <% if (lowStock > 0 || outOfStock > 0) { %>
        <div class="alert mt-3 py-2" style="background:#fff3cd;border:1px solid #ffc107;font-size:.80rem;">
          <i class="fas fa-exclamation-triangle me-2" style="color:#856404;"></i>
          <% if (outOfStock > 0) { %>
            <strong><%= outOfStock %></strong> <%= locale==="fr"?"article(s) en rupture":"item(s) out of stock" %>.
          <% } %>
          <% if (lowStock > 0) { %>
            <strong><%= lowStock %></strong> <%= locale==="fr"?"article(s) en stock bas":"item(s) low stock" %>.
          <% } %>
          <a href="/pharmacy/stock?filter=low" style="color:#856404;" class="ms-1 fw-bold"><%= locale==="fr"?"Voir":"View" %></a>
        </div>
      <% } %>
    </div>
  </div>

</div>
<%- include("../partials/footer") %>












