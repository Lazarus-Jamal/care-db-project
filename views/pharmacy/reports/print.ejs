<!DOCTYPE html>
<html lang="<%= typeof locale !== "undefined" ? locale : "en" %>">
<head>
  <meta charset="UTF-8">
  <title><%= locale==="fr"?"Rapport pharmacie":"Pharmacy Report" %> — <%= (typeof facility !== "undefined" && facility && facility.name) ? facility.name : "Oseel Care" %></title>
  <style>
    * { box-sizing:border-box; margin:0; padding:0; }
    body { font-family:Arial,sans-serif; font-size:10pt; color:#222; background:#fff; padding:20px 28px; }
    h1   { font-size:14pt; margin-bottom:2px; }
    .meta{ font-size:8pt; color:#666; margin-bottom:14px; }
    .summary { display:flex; gap:16px; margin-bottom:16px; flex-wrap:wrap; }
    .s-box { border:1px solid #dee2e6; border-radius:4px; padding:7px 12px; min-width:100px; }
    .s-val { font-size:13pt; font-weight:800; }
    .s-lbl { font-size:7pt; text-transform:uppercase; color:#666; }
    .section-title { font-size:10pt; font-weight:700; margin:14px 0 5px;
                     border-bottom:2px solid #1a9e72; padding-bottom:2px; color:#157a58; }
    table { width:100%; border-collapse:collapse; font-size:9pt; }
    th  { background:#1a9e72; color:#fff; padding:5px 7px; text-align:left;
          font-size:8pt; text-transform:uppercase; letter-spacing:.03em; }
    td  { padding:3px 7px; border-bottom:1px solid #eee; }
    tr:nth-child(even) td { background:#f9f9f9; }
    @media print { body { padding:0; } }
  </style>
</head>
<body>
  <h1><%= (typeof facility !== "undefined" && facility && facility.name) ? facility.name : "Oseel Care" %> — <%= locale==="fr"?"Rapport de distribution pharmacie":"Pharmacy Distribution Report" %></h1>
  <div class="meta">
    <%= locale==="fr"?"Periode":"Period" %>: <%= dateFrom %> → <%= dateTo %>
    <% if (agentFilter) { %>&bull; Agent: <%= agentFilter %><% } %>
    &bull; <%= locale==="fr"?"Genere le":"Generated" %>: <%= new Date(generatedAt).toLocaleDateString(locale==="fr"?"fr-FR":"en-GB") %>
    <% if (typeof user !== "undefined" && user) { %>&bull; <%= user.username %><% } %>
  </div>

  <div class="summary">
    <div class="s-box"><div class="s-val" style="color:#1a9e72"><%= dispensings.length %></div><div class="s-lbl"><%= locale==="fr"?"Distributions":"Dispensings" %></div></div>
    <div class="s-box"><div class="s-val" style="color:#0d6efd"><%= dispensings.reduce(function(s,d){return s+d.qty_dispensed;},0) %></div><div class="s-lbl"><%= locale==="fr"?"Unites":"Units" %></div></div>
    <div class="s-box"><div class="s-val" style="color:#6f42c1"><%= byArticle.length %></div><div class="s-lbl"><%= locale==="fr"?"Articles":"Items" %></div></div>
  </div>

  <div class="section-title"><%= locale==="fr"?"Resume par article":"Summary by Article" %></div>
  <table>
    <thead><tr><th><%= locale==="fr"?"Article":"Article" %></th><th>Code</th><th style="text-align:right"><%= locale==="fr"?"Fois":"Count" %></th><th style="text-align:right"><%= locale==="fr"?"Unites":"Units" %></th></tr></thead>
    <tbody><% byArticle.forEach(function(a){ %><tr><td style="font-weight:700"><%= a.article %></td><td><%= a.item_number %></td><td style="text-align:right"><%= a.count %></td><td style="text-align:right;font-weight:700;color:#1a9e72"><%= a.total_dispensed %></td></tr><% }); %></tbody>
  </table>

  <% if (isSup && byAgent.length) { %>
    <div class="section-title"><%= locale==="fr"?"Resume par agent":"Summary by Agent" %></div>
    <table>
      <thead><tr><th>Agent</th><th style="text-align:right"><%= locale==="fr"?"Distributions":"Dispensings" %></th><th style="text-align:right"><%= locale==="fr"?"Unites":"Units" %></th></tr></thead>
      <tbody><% byAgent.forEach(function(a){ %><tr><td style="font-weight:700"><%= a.agent %></td><td style="text-align:right"><%= a.count %></td><td style="text-align:right;font-weight:700;color:#6f42c1"><%= a.total %></td></tr><% }); %></tbody>
    </table>
  <% } %>

  <div class="section-title" style="margin-top:18px"><%= locale==="fr"?"Detail complet":"Full Detail" %></div>
  <table>
    <thead><tr><th><%= locale==="fr"?"Article":"Article" %></th><th style="text-align:right">Qte</th><th>Facture</th><th>Agent</th><th>Date</th></tr></thead>
    <tbody>
      <% dispensings.forEach(function(d){ %>
        <tr><td><%= d.article %></td><td style="text-align:right;font-weight:700;color:#1a9e72"><%= d.qty_dispensed %></td><td>#<%= d.bill_no %></td><td><%= d.dispensed_by %></td><td><%= new Date(d.dispensed_at).toLocaleDateString(locale==="fr"?"fr-FR":"en-GB") %></td></tr>
      <% }); %>
    </tbody>
  </table>
  <script>window.onload=function(){window.print();}</script>
</body>
</html>



