<!DOCTYPE html>
<html lang="<%= typeof locale !== "undefined" ? locale : "en" %>">
<head>
  <meta charset="UTF-8">
  <title><%= title %> — Oseel Care</title>
  <style>
    * { box-sizing:border-box; margin:0; padding:0; }
    body { font-family:'Arial',sans-serif; font-size:10pt; color:#222; background:#fff; padding:20px 28px; }
    h1 { font-size:14pt; margin-bottom:4px; }
    .meta { font-size:8pt; color:#666; margin-bottom:16px; }
    table { width:100%; border-collapse:collapse; font-size:9pt; margin-top:12px; }
    th { background:#333; color:#fff; padding:5px 8px; text-align:left; font-size:8pt; text-transform:uppercase; letter-spacing:.03em; }
    td { padding:4px 8px; border-bottom:1px solid #eee; }
    tr:nth-child(even) td { background:#f9f9f9; }
    .summary { display:flex; gap:20px; margin-bottom:16px; flex-wrap:wrap; }
    .s-box { border:1px solid #dee2e6; border-radius:4px; padding:8px 14px; min-width:110px; }
    .s-val { font-size:13pt; font-weight:800; }
    .s-lbl { font-size:7pt; text-transform:uppercase; color:#666; }
    .section-title { font-size:10pt; font-weight:700; margin:14px 0 6px; border-bottom:2px solid #333; padding-bottom:3px; }
    @media print { body { padding:0; } }
  </style>
</head>
<body>
  <h1><i>Oseel Care</i> — <%= title %></h1>
  <div class="meta">
    <%= locale==="fr"?"Genere le":"Generated" %> <%= new Date(generatedAt).toLocaleDateString(locale==="fr"?"fr-FR":"en-GB") %>
    &bull; <%= user ? user.username : "" %>
  </div>

  <div class="section-title"><%= locale==="fr"?"Resume par inventaire":"Summary by Count" %></div>
  <table><thead><tr><th><%= locale==="fr"?"N° Inventaire":"Count No." %></th><th>Date</th><th><%= locale==="fr"?"Par":"By" %></th><th>Total</th><th style="color:#dc3545"><%= locale==="fr"?"Avec ecart":"Variances" %></th><th><%= locale==="fr"?"Ecart total":"Total Var." %></th></tr></thead>
    <tbody><% countSummary.forEach(function(c){ %><tr><td><%= c.count_number %></td><td><%= new Date(c.count_date).toLocaleDateString(locale==="fr"?"fr-FR":"en-GB") %></td><td><%= c.initiated_by %></td><td><%= c.total_items %></td><td style="color:#dc3545;font-weight:700"><%= c.with_variance %></td><td style="font-weight:700"><%= c.total_variance %></td></tr><% }); %></tbody>
  </table>
  <div class="section-title"><%= locale==="fr"?"Detail des ecarts":"Variance Detail" %></div>
  <table><thead><tr><th><%= locale==="fr"?"Inventaire":"Count" %></th><th><%= locale==="fr"?"Produit":"Product" %></th><th>Sys.</th><th><%= locale==="fr"?"Compte":"Counted" %></th><th><%= locale==="fr"?"Ecart":"Variance" %></th><th><%= locale==="fr"?"Motif":"Reason" %></th></tr></thead>
    <tbody><% allItems.forEach(function(item){ %><tr><td><%= item.count_number %></td><td><%= item.product %></td><td><%= item.system_qty %></td><td><%= item.counted_qty %></td><td style="font-weight:700;color:<%= item.variance<0?"#dc3545":"#856404" %>"><%= item.variance>0?"+"+item.variance:item.variance %></td><td><%= item.variance_reason||"" %></td></tr><% }); %></tbody>
  </table>
  <script>window.onload=function(){window.print();}</script>
</body>
</html>

