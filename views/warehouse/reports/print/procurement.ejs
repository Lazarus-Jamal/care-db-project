<!DOCTYPE html>
<html lang="<%= typeof locale !== "undefined" ? locale : "en" %>">
<head>
  <meta charset="UTF-8">
  <title><%= title %> — Oseel Care</title>
  <style>
    * { box-sizing:border-box; margin:0; padding:0; }
    body { font-family:'Arial',sans-serif; font-size:10pt; color:#222; background:#fff; padding:20px 28px; }
    h1 { font-size:14pt; margin-bottom:4px; }
    .meta { font-size:8pt; color:#666; margin-bottom:16px; }
    table { width:100%; border-collapse:collapse; font-size:9pt; margin-top:12px; }
    th { background:#333; color:#fff; padding:5px 8px; text-align:left; font-size:8pt; text-transform:uppercase; letter-spacing:.03em; }
    td { padding:4px 8px; border-bottom:1px solid #eee; }
    tr:nth-child(even) td { background:#f9f9f9; }
    .summary { display:flex; gap:20px; margin-bottom:16px; flex-wrap:wrap; }
    .s-box { border:1px solid #dee2e6; border-radius:4px; padding:8px 14px; min-width:110px; }
    .s-val { font-size:13pt; font-weight:800; }
    .s-lbl { font-size:7pt; text-transform:uppercase; color:#666; }
    .section-title { font-size:10pt; font-weight:700; margin:14px 0 6px; border-bottom:2px solid #333; padding-bottom:3px; }
    @media print { body { padding:0; } }
  </style>
</head>
<body>
  <h1><i>Oseel Care</i> — <%= title %></h1>
  <div class="meta">
    <%= locale==="fr"?"Genere le":"Generated" %> <%= new Date(generatedAt).toLocaleDateString(locale==="fr"?"fr-FR":"en-GB") %>
    &bull; <%= user ? user.username : "" %>
  </div>

  <div class="summary">
    <div class="s-box"><div class="s-val" style="color:#fd7e14"><%= pos.length %></div><div class="s-lbl">BCs</div></div>
    <div class="s-box"><div class="s-val" style="color:#0a3622;font-size:10pt"><%= fmtFCFA(grandTotal) %> FCFA</div><div class="s-lbl"><%= locale==="fr"?"Valeur totale":"Total" %></div></div>
    <div class="s-box"><div class="s-val" style="color:#6f42c1;font-size:10pt"><%= fmtFCFA(reimbTotal) %> FCFA</div><div class="s-lbl">Remb.</div></div>
  </div>
  <div class="section-title"><%= locale==="fr"?"Tendance mensuelle":"Monthly Trend" %></div>
  <table><thead><tr><th><%= locale==="fr"?"Mois":"Month" %></th><th>BCs</th><th style="text-align:right"><%= locale==="fr"?"Valeur":"Value" %></th><th style="text-align:right"><%= locale==="fr"?"Paye":"Paid" %></th></tr></thead>
    <tbody><% monthly.forEach(function(m){ %><tr><td><%= m.month %></td><td><%= m.count %></td><td style="text-align:right"><%= fmtFCFA(m.total) %> FCFA</td><td style="text-align:right"><%= fmtFCFA(m.paid) %> FCFA</td></tr><% }); %></tbody>
  </table>
  <div class="section-title"><%= locale==="fr"?"Par fournisseur":"By Supplier" %></div>
  <table><thead><tr><th><%= locale==="fr"?"Fournisseur":"Supplier" %></th><th>BCs</th><th style="text-align:right"><%= locale==="fr"?"Valeur":"Value" %></th></tr></thead>
    <tbody><% bySupplier.forEach(function(s){ %><tr><td><%= s.name %></td><td><%= s.count %></td><td style="text-align:right"><%= fmtFCFA(s.total) %> FCFA</td></tr><% }); %></tbody>
  </table>
  <script>window.onload=function(){window.print();}</script>
</body>
</html>

