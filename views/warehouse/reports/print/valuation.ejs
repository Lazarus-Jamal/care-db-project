<!DOCTYPE html>
<html lang="<%= typeof locale !== "undefined" ? locale : "en" %>">
<head>
  <meta charset="UTF-8">
  <title><%= title %> — Oseel Care</title>
  <style>
    * { box-sizing:border-box; margin:0; padding:0; }
    body { font-family:'Arial',sans-serif; font-size:10pt; color:#222; background:#fff; padding:20px 28px; }
    h1 { font-size:14pt; margin-bottom:4px; }
    .meta { font-size:8pt; color:#666; margin-bottom:16px; }
    table { width:100%; border-collapse:collapse; font-size:9pt; margin-top:12px; }
    th { background:#333; color:#fff; padding:5px 8px; text-align:left; font-size:8pt; text-transform:uppercase; letter-spacing:.03em; }
    td { padding:4px 8px; border-bottom:1px solid #eee; }
    tr:nth-child(even) td { background:#f9f9f9; }
    .summary { display:flex; gap:20px; margin-bottom:16px; flex-wrap:wrap; }
    .s-box { border:1px solid #dee2e6; border-radius:4px; padding:8px 14px; min-width:110px; }
    .s-val { font-size:13pt; font-weight:800; }
    .s-lbl { font-size:7pt; text-transform:uppercase; color:#666; }
    .section-title { font-size:10pt; font-weight:700; margin:14px 0 6px; border-bottom:2px solid #333; padding-bottom:3px; }
    @media print { body { padding:0; } }
  </style>
</head>
<body>
  <h1><i>Oseel Care</i> — <%= title %></h1>
  <div class="meta">
    <%= locale==="fr"?"Genere le":"Generated" %> <%= new Date(generatedAt).toLocaleDateString(locale==="fr"?"fr-FR":"en-GB") %>
    &bull; <%= user ? user.username : "" %>
  </div>

  <div class="summary">
    <div class="s-box"><div class="s-val" style="color:#0d6efd"><%= rows.length %></div><div class="s-lbl"><%= locale==="fr"?"Produits":"Products" %></div></div>
    <div class="s-box"><div class="s-val" style="color:#0a3622;font-size:11pt"><%= fmtFCFA(totalValue) %> FCFA</div><div class="s-lbl"><%= locale==="fr"?"Valeur totale":"Total Value" %></div></div>
  </div>
  <div class="section-title"><%= locale==="fr"?"Valorisation par categorie":"Valuation by Category" %></div>
  <table><thead><tr><th><%= locale==="fr"?"Categorie":"Category" %></th><th>Articles</th><th style="text-align:right"><%= locale==="fr"?"Valeur":"Value" %></th></tr></thead>
    <tbody><% byCat.forEach(function(c){ %><tr><td><%= c.name %></td><td><%= c.items %></td><td style="text-align:right"><%= fmtFCFA(c.value) %> FCFA</td></tr><% }); %></tbody>
  </table>
  <div class="section-title" style="margin-top:16px"><%= locale==="fr"?"Detail produits":"Product Detail" %></div>
  <table><thead><tr><th><%= locale==="fr"?"Produit":"Product" %></th><th>Code</th><th><%= locale==="fr"?"Categorie":"Category" %></th><th style="text-align:right">Stock</th><th style="text-align:right"><%= locale==="fr"?"Px unit":"Unit Price" %></th><th style="text-align:right"><%= locale==="fr"?"Valeur":"Value" %></th></tr></thead>
    <tbody>
      <% rows.forEach(function(r){ %><tr><td><%= r.name %></td><td><%= r.item_code %></td><td><%= r.categoryName %></td><td style="text-align:right"><%= r.current_stock %></td><td style="text-align:right"><%= r.lastPrice>0?fmtFCFA(r.lastPrice)+" FCFA":"—" %></td><td style="text-align:right;font-weight:700"><%= fmtFCFA(r.totalValue) %> FCFA</td></tr><% }); %>
      <tr style="font-weight:800;background:#f0f0f0"><td colspan="5"><%= locale==="fr"?"TOTAL":"TOTAL" %></td><td style="text-align:right"><%= fmtFCFA(totalValue) %> FCFA</td></tr>
    </tbody>
  </table>
  <script>window.onload=function(){window.print();}</script>
</body>
</html>

