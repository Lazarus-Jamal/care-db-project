<%- include("../../partials/header", { title: title }) %>
<%- include("../../partials/navbar", { activePage: "warehouse", user: user }) %>
<style>
  .content-wrapper { background-color: #f0f2f5; }
  .card { background:#fff !important; }
  .table-xs td,.table-xs th { padding:4px 8px; font-size:.78rem; }
  .btn-xs { padding:2px 7px; font-size:.70rem; }
  .lbl { font-size:.68rem; font-weight:700; text-transform:uppercase; letter-spacing:.06em; color:#6c757d; }
  .stat-box { background:#fff; border-radius:.5rem; border:1px solid #dee2e6;
              padding:14px 16px; text-align:center; }
  .stat-val  { font-size:1.5rem; font-weight:800; line-height:1; }
  .stat-lbl  { font-size:.68rem; text-transform:uppercase; letter-spacing:.05em; color:#6c757d; font-weight:600; margin-top:4px; }
  tbody tr:nth-child(odd) > td,
  tbody tr:nth-child(odd) > th  { background-color: #f0f4ff !important; }
  tbody tr:nth-child(even) > td,
  tbody tr:nth-child(even) > th { background-color: #ffffff !important; }
  tbody tr:hover > td,
  tbody tr:hover > th           { background-color: #dce8ff !important; }
</style>
<div class="container-fluid py-3 px-4 content-wrapper">
  <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
      <h5 class="mb-0 fw-bold"><i class="fas fa-pills me-2" style="color:#6f42c1;"></i>
        <%= locale==="fr"?"Consommation stock":"Stock Consumption" %>
      </h5>
      <small class="text-muted"><%= locale==="fr"?"Genere le":"Generated" %> <%= new Date().toLocaleDateString(locale==="fr"?"fr-FR":"en-GB") %></small>
    </div>
    <a href="/warehouse/reports" class="btn btn-sm btn-outline-secondary">
      <i class="fas fa-arrow-left me-1"></i><%= locale==="fr"?"Rapports":"Reports" %>
    </a>
  </div>

  <div class="card shadow-sm mb-3"><div class="card-body py-2 px-3">
    <form method="GET" action="/warehouse/reports/consumption" class="d-flex gap-2 flex-wrap align-items-end">
      <div><label class="lbl"><%= locale==="fr"?"Du":"From" %></label>
        <input type="date" name="date_from" value="<%= dateFrom %>" class="form-control form-control-sm"></div>
      <div><label class="lbl"><%= locale==="fr"?"Au":"To" %></label>
        <input type="date" name="date_to" value="<%= dateTo %>" class="form-control form-control-sm"></div>
      <div><label class="lbl"><%= locale==="fr"?"Categorie":"Category" %></label>
        <select name="category_id" class="form-select form-select-sm">
          <option value=""><%= locale==="fr"?"Toutes":"All" %></option>
          <% categories.forEach(function(c){ %>
            <option value="<%= c.category_id %>" <%= catId==c.category_id?"selected":"" %>><%= c.name %></option>
          <% }); %>
        </select>
      </div>
      <button type="submit" class="btn btn-sm btn-outline-secondary"><i class="fas fa-filter"></i></button>
      <a href="/warehouse/reports/consumption?print=1&date_from=<%= dateFrom %>&date_to=<%= dateTo %><%= catId?"&category_id="+catId:"" %>"
         target="_blank" class="btn btn-sm btn-outline-primary ms-auto">
        <i class="fas fa-print me-1"></i><%= locale==="fr"?"Imprimer":"Print" %>
      </a>
    </form>
  </div></div>

  <div class="row g-3 mb-3">
    <div class="col-md-3"><div class="stat-box shadow-sm">
      <div class="stat-val" style="color:#6f42c1;"><%= rows.length %></div>
      <div class="stat-lbl"><%= locale==="fr"?"Produits emis":"Products issued" %></div>
    </div></div>
    <div class="col-md-3"><div class="stat-box shadow-sm">
      <div class="stat-val" style="color:#0d6efd;">
        <%= rows.reduce(function(s,r){return s+r.totalIssued;},0) %>
      </div>
      <div class="stat-lbl"><%= locale==="fr"?"Total unites emises":"Total units issued" %></div>
    </div></div>
  </div>

  <div class="card shadow-sm">
    <div class="card-header py-2 fw-bold" style="font-size:.82rem;">
      <i class="fas fa-list me-2" style="color:#6f42c1;"></i>Top <%= rows.length %> <%= locale==="fr"?"produits consommes":"consumed products" %>
    </div>
    <div class="card-body p-0">
      <table class="table table-xs table-hover align-middle mb-0">
        <thead class="table-dark"><tr>
          <th>#</th><th><%= locale==="fr"?"Produit":"Product" %></th>
          <th><%= locale==="fr"?"Categorie":"Category" %></th>
          <th><%= locale==="fr"?"Unite":"Unit" %></th>
          <th class="text-center"><%= locale==="fr"?"Total emis":"Total Issued" %></th>
          <th class="text-center"><%= locale==="fr"?"Nb emissions":"Issues Count" %></th>
        </tr></thead>
        <tbody>
          <% if (!rows.length) { %>
            <tr><td colspan="6" class="text-center text-muted py-4"><%= locale==="fr"?"Aucune emission.":"No issues." %></td></tr>
          <% } else { rows.forEach(function(r,idx){ %>
            <tr>
              <td class="text-muted"><%= idx+1 %></td>
              <td><span class="fw-bold" style="font-size:.78rem;"><%= r.name %></span>
                <code class="ms-1" style="font-size:.66rem;color:#6c757d;"><%= r.code %></code></td>
              <td class="text-muted"><%= r.catName %></td>
              <td class="text-muted"><%= r.unit %></td>
              <td class="text-center fw-bold" style="color:#6f42c1;"><%= r.totalIssued %></td>
              <td class="text-center text-muted"><%= r.issueCount %></td>
            </tr>
          <% }); } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<%- include("../../partials/footer") %>















