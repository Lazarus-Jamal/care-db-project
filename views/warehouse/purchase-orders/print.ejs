
<!DOCTYPE html>
<html lang="<%= typeof locale !== "undefined" ? locale : "en" %>">
<head>
  <meta charset="UTF-8">
  <title><%= po.po_number %></title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Arial', sans-serif;
      font-size: 11pt;
      color: #222;
      background: #fff;
      padding: 24px 32px;
    }
    .po-header { display: flex; justify-content: space-between; align-items: flex-start;
                 border-bottom: 2px solid #222; padding-bottom: 14px; margin-bottom: 18px; }
    .po-header .hospital { font-size: 15pt; font-weight: 700; }
    .po-header .po-ref   { text-align: right; }
    .po-ref .po-number   { font-size: 14pt; font-weight: 700; color: #1a5276; }
    .po-ref .po-label    { font-size: 8pt; text-transform: uppercase; color: #888; }
    .po-ref .po-status   { display:inline-block; padding:2px 8px; border-radius:4px;
                           font-size:8pt; font-weight:700; text-transform:uppercase;
                           background:#d1e7dd; color:#0a3622; margin-top:4px; }
    .section-title { font-size:9pt; font-weight:700; text-transform:uppercase;
                     letter-spacing:.06em; color:#888; margin-bottom:6px; }
    .info-grid { display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:20px; }
    .info-box  { border:1px solid #dee2e6; border-radius:4px; padding:10px 14px; }
    .info-row  { display:flex; justify-content:space-between; padding:2px 0;
                 font-size:10pt; }
    .info-row span:first-child { color:#666; }
    .info-row span:last-child  { font-weight:600; }
    table { width:100%; border-collapse:collapse; margin-bottom:16px; }
    thead tr { background:#1a5276; color:#fff; }
    thead th { padding:7px 10px; font-size:9pt; text-align:left; }
    thead th.text-right { text-align:right; }
    tbody tr { border-bottom:1px solid #e9ecef; }
    tbody tr:nth-child(even) { background:#f8f9fa; }
    tbody td { padding:6px 10px; font-size:10pt; }
    tbody td.text-right { text-align:right; }
    tfoot tr { background:#eaf2fb; font-weight:700; }
    tfoot td { padding:7px 10px; font-size:10pt; }
    tfoot td.text-right { text-align:right; }
    .approvals { display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-top:24px; }
    .approval-box { border:1px solid #dee2e6; border-radius:4px; padding:12px 14px; }
    .approval-box .title { font-size:9pt; font-weight:700; text-transform:uppercase;
                           color:#888; margin-bottom:8px; }
    .approval-box .sig-line { border-top:1px solid #222; margin-top:24px;
                              padding-top:4px; font-size:8pt; color:#888; }
    .footer-note { margin-top:20px; font-size:8pt; color:#888; text-align:center;
                   border-top:1px solid #dee2e6; padding-top:8px; }
    @media print {
      body { padding: 0; }
      .no-print { display:none !important; }
    }
  </style>
</head>
<body>

  <%/* ── Header ── */%>
  <div class="po-header">
    <%- include("../../partials/documentHeader", { facility: typeof facility !== "undefined" ? facility : null }) %>
    <div class="po-ref">
      <div class="po-label"><%= typeof locale !== "undefined" && locale==="fr" ? "BON DE COMMANDE" : "PURCHASE ORDER" %></div>
      <div class="po-number"><%= po.po_number %></div>
      <div class="po-status"><%= po.status.replace("_"," ").toUpperCase() %></div>
      <div style="font-size:9pt; color:#666; margin-top:4px;">
        <%= typeof locale !== "undefined" && locale==="fr" ? "Imprimé le :" : "Printed:" %>
        <%= new Date(printDate).toLocaleDateString(typeof locale !== "undefined" && locale==="fr" ? "fr-FR":"en-GB") %>
      </div>
    </div>
  </div>

  <%/* ── Info grid ── */%>
  <div class="info-grid">
    <div class="info-box">
      <div class="section-title"><%= typeof locale !== "undefined" && locale==="fr" ? "Fournisseur" : "Supplier" %></div>
      <div class="info-row">
        <span><%= typeof locale !== "undefined" && locale==="fr" ? "Nom" : "Name" %>:</span>
        <span><%= po.supplier ? po.supplier.name : "—" %></span>
      </div>
      <% if (po.supplier && po.supplier.contact_person) { %>
        <div class="info-row">
          <span><%= typeof locale !== "undefined" && locale==="fr" ? "Contact" : "Contact" %>:</span>
          <span><%= po.supplier.contact_person %></span>
        </div>
      <% } %>
      <% if (po.supplier && po.supplier.phone) { %>
        <div class="info-row"><span><%= typeof locale !== "undefined" && locale==="fr" ? "Tél" : "Phone" %>:</span><span><%= po.supplier.phone %></span></div>
      <% } %>
      <% if (po.supplier && po.supplier.email) { %>
        <div class="info-row"><span>Email:</span><span><%= po.supplier.email %></span></div>
      <% } %>
      <% if (po.supplier && po.supplier.payment_terms) { %>
        <div class="info-row">
          <span><%= typeof locale !== "undefined" && locale==="fr" ? "Conditions paiement" : "Payment terms" %>:</span>
          <span><%= po.supplier.payment_terms %></span>
        </div>
      <% } %>
    </div>

    <div class="info-box">
      <div class="section-title"><%= typeof locale !== "undefined" && locale==="fr" ? "Détails de la commande" : "Order Details" %></div>
      <div class="info-row">
        <span><%= typeof locale !== "undefined" && locale==="fr" ? "N° Commande" : "PO Number" %>:</span>
        <span><%= po.po_number %></span>
      </div>
      <div class="info-row">
        <span><%= typeof locale !== "undefined" && locale==="fr" ? "Date" : "Date" %>:</span>
        <span><%= new Date(po.create_time).toLocaleDateString(typeof locale !== "undefined" && locale==="fr" ? "fr-FR":"en-GB") %></span>
      </div>
      <% if (po.expected_delivery_date) { %>
        <div class="info-row">
          <span><%= typeof locale !== "undefined" && locale==="fr" ? "Livraison prévue" : "Expected delivery" %>:</span>
          <span><%= new Date(po.expected_delivery_date).toLocaleDateString(typeof locale !== "undefined" && locale==="fr" ? "fr-FR":"en-GB") %></span>
        </div>
      <% } %>
      <% if (po.director_approved_by) { %>
        <div class="info-row">
          <span><%= typeof locale !== "undefined" && locale==="fr" ? "Approuvé (Directeur)" : "Approved (Director)" %>:</span>
          <span><%= po.director_approved_by %></span>
        </div>
      <% } %>
      <% if (po.finance_approved_by) { %>
        <div class="info-row">
          <span><%= typeof locale !== "undefined" && locale==="fr" ? "Approuvé (Finance)" : "Approved (Finance)" %>:</span>
          <span><%= po.finance_approved_by %></span>
        </div>
      <% } %>
    </div>
  </div>

  <%/* ── Items table ── */%>
  <div class="section-title"><%= typeof locale !== "undefined" && locale==="fr" ? "Articles commandés" : "Items Ordered" %></div>
  <table>
    <thead>
      <tr>
        <th style="width:8%;">#</th>
        <th style="width:12%;"><%= typeof locale !== "undefined" && locale==="fr" ? "Code" : "Code" %></th>
        <th style="width:38%;"><%= typeof locale !== "undefined" && locale==="fr" ? "Désignation" : "Description" %></th>
        <th style="width:14%;"><%= typeof locale !== "undefined" && locale==="fr" ? "Unité" : "Unit" %></th>
        <th class="text-right" style="width:12%;"><%= typeof locale !== "undefined" && locale==="fr" ? "Qté" : "Qty" %></th>
        <th class="text-right" style="width:16%;"><%= typeof locale !== "undefined" && locale==="fr" ? "Prix unit." : "Unit Price" %></th>
        <th class="text-right">Total</th>
      </tr>
    </thead>
    <tbody>
      <% po.items.forEach(function(item, idx) { %>
        <tr>
          <td><%= idx + 1 %></td>
          <td><code style="font-size:9pt;"><%= item.product ? item.product.item_code : "—" %></code></td>
          <td><%= item.product ? item.product.name : "—" %></td>
          <td style="font-size:9pt; color:#666;"><%= item.product ? item.product.unit_of_measure : "—" %></td>
          <td class="text-right"><%= item.quantity_ordered %></td>
          <td class="text-right"><%= fmtFCFA(item.unit_price) %></td>
          <td class="text-right"><%= fmtFCFA(item.total_price) %></td>
        </tr>
      <% }); %>
    </tbody>
    <tfoot>
      <tr>
        <td colspan="5" class="text-right">
          <%= typeof locale !== "undefined" && locale==="fr" ? "TOTAL GÉNÉRAL :" : "GRAND TOTAL:" %>
        </td>
        <td class="text-right" colspan="2" style="font-size:12pt; color:#1a5276;">
          <%= fmtFCFA(po.total_amount) %>
        </td>
      </tr>
    </tfoot>
  </table>

  <% if (po.notes) { %>
    <div style="border:1px solid #dee2e6; border-radius:4px; padding:8px 12px; font-size:9pt; margin-bottom:16px;">
      <strong><%= typeof locale !== "undefined" && locale==="fr" ? "Notes :" : "Notes:" %></strong>
      <%= po.notes %>
    </div>
  <% } %>

  <%/* ── Approval signatures ── */%>
  <div class="approvals">
    <div class="approval-box">
      <div class="title"><%= typeof locale !== "undefined" && locale==="fr" ? "Approuvé par le Directeur" : "Director Approval" %></div>
      <% if (po.director_approved_by) { %>
        <div style="font-size:10pt; font-weight:600; margin-bottom:4px;"><%= po.director_approved_by %></div>
        <div style="font-size:9pt; color:#666;">
          <%= po.director_approved_at ? new Date(po.director_approved_at).toLocaleDateString(typeof locale !== "undefined" && locale==="fr" ? "fr-FR":"en-GB") : "" %>
        </div>
      <% } else { %>
        <div class="sig-line"><%= typeof locale !== "undefined" && locale==="fr" ? "Signature / Date" : "Signature / Date" %></div>
      <% } %>
    </div>
    <div class="approval-box">
      <div class="title"><%= typeof locale !== "undefined" && locale==="fr" ? "Approuvé par la Finance" : "Finance Approval" %></div>
      <% if (po.finance_approved_by) { %>
        <div style="font-size:10pt; font-weight:600; margin-bottom:4px;"><%= po.finance_approved_by %></div>
        <div style="font-size:9pt; color:#666;">
          <%= po.finance_approved_at ? new Date(po.finance_approved_at).toLocaleDateString(typeof locale !== "undefined" && locale==="fr" ? "fr-FR":"en-GB") : "" %>
        </div>
      <% } else { %>
        <div class="sig-line"><%= typeof locale !== "undefined" && locale==="fr" ? "Signature / Date" : "Signature / Date" %></div>
      <% } %>
    </div>
  </div>

  <div class="footer-note">
    <%= typeof locale !== "undefined" && locale==="fr"
      ? "Ce bon de commande a été généré par le système Oseel Care HMIS. Veuillez le conserver comme référence officielle."
      : "This purchase order was generated by Oseel Care HMIS. Please retain as an official reference document." %>
  </div>

  <%/* Print button — hidden when printing */%>
  <div class="no-print" style="text-align:center; margin-top:24px;">
    <button onclick="window.print()" style="padding:8px 24px; font-size:11pt; cursor:pointer;">
      <% if (typeof locale !== "undefined" && locale==="fr") { %>Imprimer<% } else { %>Print<% } %>
    </button>
    <button onclick="window.close()" style="padding:8px 16px; font-size:11pt; cursor:pointer; margin-left:8px;">
      <% if (typeof locale !== "undefined" && locale==="fr") { %>Fermer<% } else { %>Close<% } %>
    </button>
  </div>

</body>
</html>




