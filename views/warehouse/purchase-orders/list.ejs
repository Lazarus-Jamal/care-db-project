<%- include("../../partials/header", { title: title }) %>
<%- include("../../partials/navbar", { activePage: "warehouse", user: user }) %>

<style>
  .content-wrapper { background-color: #f0f2f5; }
  .card       { background: #fff !important; }
  .table-xs td, .table-xs th { padding: 5px 9px; font-size: .80rem; }
  .btn-xs     { padding: 2px 7px; font-size: .70rem; }
  .status-pill { display:inline-block; padding:2px 8px; border-radius:20px;
                 font-size:.62rem; font-weight:700; text-transform:uppercase;
                 letter-spacing:.05em; white-space:nowrap; }
  .s-draft           { background:#e9ecef; color:#495057; }
  .s-pending_manager  { background:#fde8d8; color:#7a3200; }
  .s-pending_director{ background:#fff3cd; color:#856404; }
  .s-pending_finance { background:#cfe2ff; color:#084298; }
  .s-approved        { background:#d1e7dd; color:#0a3622; }
  .s-sent            { background:#d0d3f8; color:#1a1f8c; }
  .s-partial         { background:#fde8d8; color:#7a3200; }
  .s-received        { background:#d1e7dd; color:#0a3622; }
  .s-closed          { background:#dee2e6; color:#6c757d; }
  .s-cancelled       { background:#f8d7da; color:#842029; }
  tbody tr:nth-child(odd) > td,
  tbody tr:nth-child(odd) > th  { background-color: #f0f4ff !important; }
  tbody tr:nth-child(even) > td,
  tbody tr:nth-child(even) > th { background-color: #ffffff !important; }
  tbody tr:hover > td,
  tbody tr:hover > th           { background-color: #dce8ff !important; }
</style>

<div class="container-fluid py-3 px-4 content-wrapper">

  <%/* Header */%>
  <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
      <h5 class="mb-0 fw-bold">
        <i class="fas fa-file-invoice me-2 text-warning"></i>
        <%= locale==="fr" ? "Bons de commande" : "Purchase Orders" %>
      </h5>
      <small class="text-muted"><%= totalCount %> <%= locale==="fr" ? "commande(s)" : "order(s)" %></small>
    </div>
    <div class="d-flex gap-2">
      <% if (typeof hasPermission !== "undefined" && hasPermission("Warehouse.Create.PurchaseOrder")) { %>
        <a href="/warehouse/purchase-orders/new" class="btn btn-sm btn-success">
          <i class="fas fa-plus me-1"></i>
          <%= locale==="fr" ? "Nouvelle commande" : "New PO" %>
        </a>
      <% } %>
      <a href="/warehouse" class="btn btn-sm btn-outline-secondary">
        <i class="fas fa-arrow-left me-1"></i>
        Dashboard
      </a>
    </div>
  </div>

  <%/* Status filter tabs */%>
  <%
    var tabs = [
      { key:"",                 label: locale==="fr"?"Toutes":"All" },
      { key:"draft",            label: locale==="fr"?"Brouillon":"Draft" },
      { key:"pending_manager",  label: locale==="fr"?"Att. Manager":"Pending Manager" },
      { key:"pending_director", label: locale==="fr"?"Att. Directeur":"Pending Director" },
      { key:"pending_finance",  label: locale==="fr"?"Att. Finance":"Pending Finance" },
      { key:"approved",         label: locale==="fr"?"Approuvee":"Approved" },
      { key:"sent",             label: locale==="fr"?"Envoyee":"Sent" },
      { key:"partial",          label: locale==="fr"?"Partielle":"Partial" },
      { key:"received",         label: locale==="fr"?"Recue":"Received" },
      { key:"cancelled",        label: locale==="fr"?"Annulee":"Cancelled" },
    ];
  %>
  <div class="card shadow-sm mb-3">
    <div class="card-body py-2 px-3">
      <div class="d-flex gap-1 flex-wrap align-items-center">
        <% tabs.forEach(function(tab) { %>
          <a href="/warehouse/purchase-orders?status=<%= tab.key %>"
            class="btn btn-xs <%= statusFilter === tab.key ? "btn-primary" : "btn-outline-secondary" %>">
            <%= tab.label %>
            <% if (tab.key && countMap[tab.key]) { %>
              <span class="badge bg-secondary ms-1" style="font-size:.58rem;"><%= countMap[tab.key] %></span>
            <% } %>
          </a>
        <% }); %>
      </div>
    </div>
  </div>

  <%/* Table */%>
  <div class="card shadow-sm">
    <div class="card-body p-0">
      <% if (!pos || pos.length === 0) { %>
        <div class="text-center text-muted py-5">
          <i class="fas fa-file-invoice fa-2x mb-2 d-block opacity-25"></i>
          <%= locale==="fr" ? "Aucune commande trouvée." : "No purchase orders found." %>
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-xs table-hover align-middle mb-0">
            <thead class="table-dark">
              <tr>
                <th><%= locale==="fr" ? "N° Commande" : "PO Number" %></th>
                <th><%= locale==="fr" ? "Fournisseur" : "Supplier" %></th>
                <th class="text-center"><%= locale==="fr" ? "Statut" : "Status" %></th>
                <th class="text-end"><%= locale==="fr" ? "Montant total" : "Total Amount" %></th>
                <th><%= locale==="fr" ? "Livraison prévue" : "Expected Delivery" %></th>
                <th><%= locale==="fr" ? "Créé le" : "Created" %></th>
                <th class="text-center">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% pos.forEach(function(p) { %>
                <tr>
                  <td>
                    <a href="/warehouse/purchase-orders/<%= p.po_id %>" class="fw-bold text-decoration-none">
                      <%= p.po_number %>
                    </a>
                  </td>
                  <td><%= p.supplier ? p.supplier.name : "—" %></td>
                  <td class="text-center">
                    <span class="status-pill s-<%= p.status %>">
                      <%
                        var sLabels = {
                          draft: locale==="fr"?"Brouillon":"Draft",
                          pending_manager:  locale==="fr"?"Att. Manager":"Pending Manager",
                          pending_director: locale==="fr"?"Att. Directeur":"Pending Director",
                          pending_finance:  locale==="fr"?"Att. Finance":"Pending Finance",
                          approved:  locale==="fr"?"Approuvee":"Approved",
                          sent:      locale==="fr"?"Envoyee":"Sent",
                          partial:   locale==="fr"?"Partielle":"Partial",
                          received:  locale==="fr"?"Recue":"Received",
                          closed:    locale==="fr"?"Cloturee":"Closed",
                          cancelled: locale==="fr"?"Annulee":"Cancelled",
                        };
                      %>
                      <%= sLabels[p.status] || p.status %>
                    </span>
                  </td>
                  <td class="text-end fw-bold">
                    <%= fmtFCFA(p.total_amount) %>
                  </td>
                  <td class="text-muted">
                    <%= p.expected_delivery_date
                      ? new Date(p.expected_delivery_date).toLocaleDateString(locale==="fr"?"fr-FR":"en-GB")
                      : "—" %>
                  </td>
                  <td class="text-muted">
                    <%= new Date(p.create_time).toLocaleDateString(locale==="fr"?"fr-FR":"en-GB") %>
                  </td>
                  <td class="text-center">
                    <div class="d-flex justify-content-center gap-1">
                      <a href="/warehouse/purchase-orders/<%= p.po_id %>"
                        class="btn btn-xs btn-outline-secondary"
                        title="<%= locale==="fr"?"Voir":"View" %>">
                        <i class="fas fa-eye"></i>
                      </a>
                      <% if (p.status === "approved" || p.status === "sent") { %>
                        <a href="/warehouse/purchase-orders/<%= p.po_id %>/print"
                          class="btn btn-xs btn-outline-primary" target="_blank"
                          title="<%= locale==="fr"?"Imprimer":"Print" %>">
                          <i class="fas fa-print"></i>
                        </a>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>

        <%/* Pagination */%>
        <% if (totalPages > 1) { %>
          <div class="d-flex justify-content-between align-items-center px-3 py-2 border-top">
            <small class="text-muted">Page <%= currentPage %> / <%= totalPages %></small>
            <div class="d-flex gap-1">
              <% if (currentPage > 1) { %>
                <a href="?page=<%= currentPage-1 %>&status=<%= statusFilter %>" class="btn btn-xs btn-outline-secondary">‹</a>
              <% } %>
              <% if (currentPage < totalPages) { %>
                <a href="?page=<%= currentPage+1 %>&status=<%= statusFilter %>" class="btn btn-xs btn-outline-secondary">›</a>
              <% } %>
            </div>
          </div>
        <% } %>
      <% } %>
    </div>
  </div>

</div>
</div>
<%- include("../../partials/footer") %>
















