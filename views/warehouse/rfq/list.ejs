<%- include("../../partials/header", { title: title }) %>
<%- include("../../partials/navbar", { activePage: "warehouse", user: user }) %>
<style>
  .content-wrapper { background-color: #f0f2f5; }
  .card { background:#fff !important; } .table-xs td,.table-xs th { padding:5px 9px; font-size:.80rem; }
  .btn-xs { padding:2px 7px; font-size:.70rem; }
  .sp { display:inline-block; padding:2px 8px; border-radius:20px; font-size:.62rem; font-weight:700; text-transform:uppercase; white-space:nowrap; }
  .s-draft{background:#e9ecef;color:#495057} .s-pending_manager{background:#fff3cd;color:#856404}
  .s-approved{background:#d1e7dd;color:#0a3622} .s-sent{background:#cfe2ff;color:#084298}
  .s-comparing{background:#d0d3f8;color:#1a1f8c} .s-closed{background:#dee2e6;color:#6c757d}
  .s-cancelled{background:#f8d7da;color:#842029} .s-expired{background:#f8d7da;color:#842029}
  tbody tr:nth-child(odd) > td,
  tbody tr:nth-child(odd) > th  { background-color: #f0f4ff !important; }
  tbody tr:nth-child(even) > td,
  tbody tr:nth-child(even) > th { background-color: #ffffff !important; }
  tbody tr:hover > td,
  tbody tr:hover > th           { background-color: #dce8ff !important; }
</style>
<div class="container-fluid py-3 px-4 content-wrapper">
  <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
      <h5 class="mb-0 fw-bold"><i class="fas fa-file-alt me-2 text-info"></i><%= locale==="fr"?"Demandes de cotation":"Requests for Quotation" %></h5>
      <small class="text-muted"><%= totalCount %> RFQ(s)</small>
    </div>
    <div class="d-flex gap-2">
      <% if (typeof hasPermission !== "undefined" && hasPermission("Warehouse.Create.RFQ")) { %>
        <a href="/warehouse/rfq/new" class="btn btn-sm btn-info text-white"><i class="fas fa-plus me-1"></i> New RFQ</a>
      <% } %>
      <a href="/warehouse" class="btn btn-sm btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i> Dashboard</a>
    </div>
  </div>
  <%
    var tabs=[{key:"",label:locale==="fr"?"Toutes":"All"},{key:"draft",label:"Draft"},{key:"pending_manager",label:locale==="fr"?"Att. Manager":"Pending Mgr"},
      {key:"approved",label:locale==="fr"?"Approuvee":"Approved"},{key:"sent",label:locale==="fr"?"Envoyee":"Sent"},
      {key:"comparing",label:locale==="fr"?"Comparaison":"Comparing"},{key:"closed",label:locale==="fr"?"Cloturee":"Closed"},
      {key:"expired",label:locale==="fr"?"Expiree":"Expired"},{key:"cancelled",label:locale==="fr"?"Annulee":"Cancelled"}];
  %>
  <div class="card shadow-sm mb-3"><div class="card-body py-2 px-3 d-flex gap-1 flex-wrap">
    <% tabs.forEach(function(t){ %>
      <a href="/warehouse/rfq?status=<%= t.key %>"
        class="btn btn-xs <%= statusFilter===t.key?"btn-primary":"btn-outline-secondary" %>">
        <%= t.label %><% if(t.key&&countMap[t.key]){ %> <span class="badge bg-secondary ms-1" style="font-size:.58rem;"><%= countMap[t.key] %></span><% } %>
      </a>
    <% }); %>
  </div></div>
  <div class="card shadow-sm">
    <div class="card-body p-0">
      <% if(!rfqs||rfqs.length===0){ %>
        <div class="text-center text-muted py-5"><i class="fas fa-file-alt fa-2x mb-2 d-block opacity-25"></i><%= locale==="fr"?"Aucune RFQ.":"No RFQs found." %></div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-xs table-hover align-middle mb-0">
            <thead class="table-dark"><tr>
              <th>N° RFQ</th><th class="text-center">Statut</th>
              <th>Expiration</th><th>Créé par</th><th>Date</th><th class="text-center">Actions</th>
            </tr></thead>
            <tbody>
              <% rfqs.forEach(function(r){ %>
                <%
                  var sLabel={draft:"Draft",pending_manager:locale==="fr"?"Att. Manager":"Pending Mgr",
                    approved:locale==="fr"?"Approuvee":"Approved",sent:locale==="fr"?"Envoyee":"Sent",
                    comparing:locale==="fr"?"Comparaison":"Comparing",closed:locale==="fr"?"Cloturee":"Closed",
                    expired:locale==="fr"?"Expiree":"Expired",cancelled:locale==="fr"?"Annulee":"Cancelled"};
                %>
                <tr>
                  <td><a href="/warehouse/rfq/<%= r.rfq_id %>" class="fw-bold text-decoration-none"><%= r.rfq_number %></a></td>
                  <td class="text-center"><span class="sp s-<%= r.status %>"><%= sLabel[r.status]||r.status %></span></td>
                  <td class="text-muted" style="font-size:.76rem;">
                    <% if(r.expiry_date){ %>
                      <% var exp=new Date(r.expiry_date); var today=new Date(); var near=exp<=new Date(today.getTime()+2*86400000); %>
                      <span class="<%= r.status==="expired"?"text-danger fw-bold":near?"text-warning":"text-muted" %>">
                        <%= exp.toLocaleDateString(locale==="fr"?"fr-FR":"en-GB") %>
                      </span>
                    <% } else { %>&mdash;<% } %>
                  </td>
                  <td class="text-muted"><%= r.created_by %></td>
                  <td class="text-muted" style="font-size:.76rem;"><%= new Date(r.create_time).toLocaleDateString(locale==="fr"?"fr-FR":"en-GB") %></td>
                  <td class="text-center">
                    <a href="/warehouse/rfq/<%= r.rfq_id %>" class="btn btn-xs btn-outline-secondary"><i class="fas fa-eye"></i></a>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</div>
<%- include("../../partials/footer") %>
















