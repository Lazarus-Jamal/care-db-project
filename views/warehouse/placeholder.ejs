<%- include("../partials/header", { title: title }) %>
<%- include("../partials/navbar", { activePage: "warehouse", user: user }) %>

<style>
  .content-wrapper { background-color: #f0f2f5; }
</style>

<div class="container-fluid px-3 pt-3 content-wrapper" style="max-width:680px;">
  <a href="<%= backUrl %>" class="btn btn-sm btn-outline-secondary mb-3">
    <i class="fas fa-arrow-left me-1"></i>
    <%= locale==="fr"?"Retour":"Back" %>
  </a>
  <div class="card shadow-sm text-center py-5">
    <div class="card-body">
      <div style="font-size:3rem;margin-bottom:16px;opacity:.3;">
        <% if (phase === 4) { %><i class="fas fa-layer-group text-info"></i>
        <% } else { %><i class="fas fa-chart-bar text-success"></i><% } %>
      </div>
      <h5 class="fw-bold mb-2">
        <%= locale==="fr"?"Module en développement":"Module Under Development" %>
      </h5>
      <p class="text-muted mb-3" style="font-size:.88rem;">
        <strong><%= feature %></strong>
      </p>
      <span class="badge bg-secondary" style="font-size:.78rem;">
        Phase <%= phase %> —
        <%= locale==="fr"?"Disponible prochainement":"Coming soon" %>
      </span>
      <% if (phase === 4) { %>
        <div class="mt-3 text-muted" style="font-size:.78rem;">
          <%= locale==="fr"
            ? "Cette phase inclut: réception des livraisons, contrôle qualité, mise en rayons et gestion des emplacements physiques."
            : "This phase includes: delivery receiving, quality control, shelving, and physical location management." %>
        </div>
      <% } %>
      <% if (phase === 6) { %>
        <div class="mt-3 text-muted" style="font-size:.78rem;">
          <%= locale==="fr"
            ? "Cette phase inclut: rapports de stock, valorisation, mouvements, alertes de péremption et performances fournisseurs."
            : "This phase includes: stock reports, valuation, movements, expiry alerts, and supplier performance reports." %>
        </div>
      <% } %>
    </div>
  </div>
</div>
</div>

<%- include("../partials/footer") %>








