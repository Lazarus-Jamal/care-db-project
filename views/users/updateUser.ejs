
<%- include("../partials/header", { title: t.users.updateTitle }) %>
<%- include("../partials/navbar") %>

<style>
  

  .form-wrapper { max-width: 860px; margin: 0 auto; }
  .form-label   { font-size: 0.75rem; font-weight: 600; margin-bottom: 2px; }
  .form-control, .form-select { font-size: 0.8rem; padding: 0.3rem 0.5rem; }
  #user_id option { cursor: pointer; }
</style>

<div class="container-fluid py-3 px-4 content-wrapper">
  <div class="card shadow-sm form-wrapper">
    <div class="card-header bg-primary text-white py-2">
      <h6 class="mb-0"><i class="fas fa-user-edit me-2"></i><%= t.users.updateTitle %></h6>
    </div>
    <div class="card-body p-3">

      <% if (success) { %>
        <div class="alert alert-success py-2 mb-2" style="font-size:0.8rem;"><%= t.users.successUpdate %></div>
      <% } %>
      <% if (errors && errors.length > 0) { %>
        <div class="alert alert-danger py-2 mb-2" style="font-size:0.8rem;">
          <ul class="mb-0"><% errors.forEach(e => { %><li><%= e %></li><% }) %></ul>
        </div>
      <% } %>

      <%/* ── Step 1: Select user ── */%>
      <form method="GET" action="/admin/users/update" id="selectForm">
        <p class="section-title mb-1" style="font-size:0.7rem;font-weight:700;text-transform:uppercase;color:#6c757d;">
          <%= t.users.selectToEdit %>
        </p>
        <div class="row g-2 mb-3">
          <div class="col-md-8">
            <input type="text" id="userSearch" class="form-control form-control-sm mb-1"
              placeholder="<%= t.users.searchUser %>">
            <%/* Pre-loaded, client-side-filtered — all users rendered up
                front, same pattern as facility search on the
                update-facility page, rather than an AJAX round-trip per
                keystroke (which also meant nothing showed at all until
                you'd typed 2+ characters). */ %>
            <select name="user_id" id="user_id" class="form-select form-select-sm" required size="4">
              <option value=""><%= t.users.selectUserPh %></option>
              <% if (typeof allUsers !== "undefined") { allUsers.forEach(function(u) { %>
                <option value="<%= u.user_id %>"
                  <%= typeof userToEdit !== "undefined" && userToEdit && String(userToEdit.user_id) === String(u.user_id) ? "selected" : "" %>>
                  <%= u.username %> —
                  <% if (u.personData) { %>
                    <%= u.personData.name_first || "" %> <%= u.personData.name_last || "" %>
                  <% } else { %><%= t.users.nameUnavail %><% } %>
                </option>
              <% }) } %>
            </select>
          </div>
          <div class="col-md-4 d-flex flex-column justify-content-end gap-1">
            <button class="btn btn-sm btn-primary" type="submit" id="btnLoad">
              <i class="fas fa-download me-1"></i><%= t.users.load %>
            </button>
            <a href="/admin/users/update" class="btn btn-sm btn-outline-secondary">
              <i class="fas fa-times me-1"></i><%= t.users.cancelSelect %>
            </a>
          </div>
        </div>
      </form>

      <% if (userToEdit) { %>
      <hr class="my-2">
      <%/* ── Step 2: Edit user ── */%>
      <p class="mb-2" style="font-size:0.78rem;">
        <i class="fas fa-user me-1 text-primary"></i>
        <%= t.users.editUser %> <strong><%= userToEdit.username %></strong>
      </p>
      <form method="POST" action="/admin/users/update/edit">
        <input type="hidden" name="user_id" value="<%= userToEdit.user_id %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="row g-2 mb-2">
          <div class="col-md-4">
            <label class="form-label"><%= t.users.generatedUser %></label>
            <input type="text" name="username" class="form-control form-control-sm"
              value="<%= userToEdit.username %>" required>
          </div>
          <div class="col-md-4">
            <label class="form-label"><%= t.users.email %></label>
            <input type="email" name="email" class="form-control form-control-sm"
              value="<%= userToEdit.email || "" %>">
          </div>
          <div class="col-md-4">
            <label class="form-label"><%= t.users.newPassword %></label>
            <input type="password" name="password" class="form-control form-control-sm"
              placeholder="<%= locale === "fr" ? "Laisser vide = inchangé" : "Leave blank = unchanged" %>">
          </div>
        </div>

        <div class="row g-2 mb-2">
          <div class="col-md-4">
            <label class="form-label"><%= t.users.role %></label>
            <select name="role_id" class="form-select form-select-sm" required>
              <option value=""><%= t.users.selectRole %></option>
              <% roles.forEach(role => { %>
                <option value="<%= role.id %>" <%= userToEdit.role_id === role.id ? "selected" : "" %>><%= role.role_name %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-4">
            <label class="form-label"><%= t.users.facility %></label>
            <select name="facility_id" id="facility_id" class="form-select form-select-sm" required>
              <option value=""><%= t.users.selectFacility %></option>
              <% facilities.forEach(f => { %>
                <option value="<%= f.id %>" <%= userToEdit.facility_id === f.id ? "selected" : "" %>><%= f.name %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-4">
            <label class="form-label"><%= t.users.department %></label>
            <select name="dept_nr" id="dept_nr" class="form-select form-select-sm">
              <option value=""><%= t.users.selectDept %></option>
              <% departments.forEach(dept => { %>
                <option value="<%= dept.nr %>" <%= userToEdit.dept_nr === dept.nr ? "selected" : "" %>><%= dept.name_formal %></option>
              <% }) %>
            </select>
          </div>
        </div>

        <div class="text-end mt-3">
          <a href="/" class="btn btn-sm btn-outline-secondary me-1"><%= t.common.cancel %></a>
          <button type="submit" class="btn btn-sm btn-success">
            <i class="fas fa-save me-1"></i><%= t.users.update %>
          </button>
        </div>
      </form>

      <%# Multi-Facility — grant this user access to more than one
          facility. The primary facility above (care_users.facility_id)
          is always implicitly included and can't be unchecked here — only
          changed by picking a different primary above. Unchecking an
          additional facility here simply removes the grant (no
          soft-deactivate on this table, unlike department assignment). %>
      <div class="card mt-3">
        <div class="card-header bg-secondary text-white py-2">
          <i class="fas fa-hospital me-2"></i>
          <%= locale==="fr" ? "Etablissements supplementaires" : "Additional Facilities" %>
        </div>
        <div class="card-body">
          <p class="text-muted mb-2" style="font-size:.8rem;">
            <%= locale==="fr"
              ? "L'etablissement principal ci-dessus est toujours inclus. Cochez les etablissements supplementaires auxquels cet utilisateur doit avoir acces."
              : "The primary facility above is always included. Check any additional facilities this user should have access to." %>
          </p>
          <form action="/admin/users/update/facilities" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="user_id" value="<%= userToEdit.user_id %>">
            <div class="row g-2">
              <% facilities.forEach(function(f) { %>
                <% var isPrimary = userToEdit.facility_id === f.id; %>
                <% var isGranted = isPrimary || (typeof grantedFacilityIds !== "undefined" && grantedFacilityIds.indexOf(f.id) !== -1); %>
                <div class="col-md-4 col-sm-6">
                  <div class="form-check">
                    <input class="form-check-input" type="checkbox"
                      name="facility_ids" value="<%= f.id %>"
                      id="grant-facility-<%= f.id %>"
                      <%= isGranted ? "checked" : "" %>
                      <%= isPrimary ? "disabled" : "" %>>
                    <label class="form-check-label" for="grant-facility-<%= f.id %>" style="font-size:.85rem;">
                      <%= f.name %>
                      <% if (isPrimary) { %>
                        <span class="badge bg-primary ms-1" style="font-size:.6rem;">
                          <%= locale==="fr" ? "Principal" : "Primary" %>
                        </span>
                      <% } %>
                    </label>
                  </div>
                </div>
              <% }); %>
            </div>
            <div class="text-end mt-3 pt-2 border-top">
              <button type="submit" class="btn btn-sm btn-success">
                <i class="fas fa-save me-1"></i>
                <%= locale==="fr" ? "Enregistrer les etablissements" : "Save Facilities" %>
              </button>
            </div>
          </form>
        </div>
      </div>
      <% } %>

    </div>
  </div>
</div>

<script>
// User search — pre-loaded, client-side filtered, same pattern as
// facility search on the update-facility page. Replaces the old
// AJAX-search-as-you-type (nothing showed until 2+ characters typed,
// 300ms debounce per keystroke, one network round-trip each time).
document.getElementById('userSearch').addEventListener('input', function() {
  const s = this.value.toLowerCase();
  document.querySelectorAll('#user_id option').forEach(function(o) {
    o.style.display = o.textContent.toLowerCase().includes(s) ? '' : 'none';
  });
});

// Double-click on option = load immediately
document.getElementById('user_id').addEventListener('dblclick', function() {
  if (this.value) document.getElementById('selectForm').submit();
});

// Departments are facility-scoped (System Configuration module). This
// filters the department dropdown only when the admin actively CHANGES
// the facility — deliberately NOT on page load, since the server has
// already correctly resolved the existing user's current department; if
// that value happens to predate this facility-scoping and wouldn't
// otherwise match, silently resetting it on load would look like data
// loss. Changing the facility is a genuine new choice, so filtering to
// what's actually valid there is correct at that point.
const facilityDeptMap = <%- JSON.stringify(typeof facilityDeptMap !== "undefined" ? facilityDeptMap : {}) %>;
const editFacilitySelectEl = document.getElementById('facility_id');
const editDeptSelectEl     = document.getElementById('dept_nr');

if (editFacilitySelectEl && editDeptSelectEl) {
  const allEditDeptOptions = Array.from(editDeptSelectEl.options);
  editFacilitySelectEl.addEventListener('change', function() {
    const allowedNrs = facilityDeptMap[this.value] || null;
    editDeptSelectEl.innerHTML = '';
    allEditDeptOptions.forEach(function(opt) {
      const isPlaceholder = opt.value === '';
      const isAllowed = isPlaceholder || !allowedNrs || allowedNrs.map(String).indexOf(opt.value) !== -1;
      if (isAllowed) editDeptSelectEl.appendChild(opt);
    });
    editDeptSelectEl.value = '';
  });
}
</script>

<%- include("../partials/footer") %>






