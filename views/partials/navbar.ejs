            </ul>

            <%/* ── Right side: user info + lang switcher + logout ── */%>
            <% if (typeof user !== "undefined" && user && user.permissions && user.permissions.length > 0) { %>
                <span class="navbar-text me-3 text-end text-white" style="font-size:1.25rem; line-height:1.3;">
                    <%= t.nav.welcome %>, <strong><%= user.firstName || user.username %></strong>
                    <br><span class="text-white" style="font-size:1.25rem;">(<%= user.roleName %>)</span>
                </span>

                <%/* Language toggle button */%>
                <% if (locale === "fr") { %>
                    <a href="/locale/en" class="btn btn-outline-light btn-sm me-2" title="Switch to English">
                        🇬🇧 EN
                    </a>
                <% } else { %>
                    <a href="/locale/fr" class="btn btn-outline-light btn-sm me-2" title="Passer en Français">
                        🇫🇷 FR
                    </a>
                <% } %>

                <a href="/auth/logout" class="btn btn-outline-light btn-sm" title="<%= t.nav.logout %>">
                    <i class="fas fa-sign-out-alt"></i>
                </a>
            <% } %>
        </div>
    </div>
</nav>





