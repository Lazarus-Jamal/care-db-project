
<%- include("../../partials/header", { title: t.procedures.lab }) %>
<%- include("../../partials/navbar") %>
<style>
  .content-wrapper { background-color: #f0f2f5; }

  tbody tr:nth-child(odd) > td,
  tbody tr:nth-child(odd) > th  { background-color: #f0f4ff !important; }
  tbody tr:nth-child(even) > td,
  tbody tr:nth-child(even) > th { background-color: #ffffff !important; }
  tbody tr:hover > td,
  tbody tr:hover > th           { background-color: #dce8ff !important; }
</style>
<div class="container-fluid py-3 px-4 content-wrapper">
  <div class="card shadow-sm">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
      <h5 class="mb-0"><i class="fas fa-flask me-2"></i><%= t.procedures.lab %></h5>
      <a href="/procedures/acts/lab/create" class="btn btn-sm btn-light">
          <i class="fas fa-plus me-1"></i><%= t.procedures.newRequest %>
        </a>
    </div>
    <div class="card-body">
      <form method="GET" action="/procedures/acts/lab" class="row g-2 mb-3">
        <div class="col-md-4">
          <input type="text" name="search" class="form-control form-control-sm"
            placeholder="<%= t.common.save %>..."
            value="<%- typeof search !== "undefined" ? search : "" %>">
        </div>
        <div class="col-md-2">
          <input type="date" name="date_from" class="form-control form-control-sm">
        </div>
        <div class="col-md-2">
          <input type="date" name="date_to" class="form-control form-control-sm">
        </div>
        <div class="col-md-2 d-flex gap-2">
          <button type="submit" class="btn btn-primary btn-sm w-100"><%= t.patientList.search %></button>
          <a href="/procedures/acts/lab" class="btn btn-secondary btn-sm w-100"><%= t.patientList.reset %></a>
        </div>
      </form>
      
      <div class="table-responsive">
        <table class="table table-hover align-middle" style="font-size:0.85rem;">
          <thead class="table-dark"><tr><th>#</th><th>batchNr</th><th>Patient</th><th>testType</th><th>requestDate</th><th>requestedBy</th><th>urgent</th><th><%= t.common.status %></th><th><%= t.common.actions %></th></tr></thead>
          <tbody>
            <% if (typeof items !== "undefined" && items.length > 0) { %>
              <% items.forEach((item, i) => { %>
                <tr><td><%= i+1 %></td><% for(let c=1;c<9;c++) { %><td>—</td><% } %></tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="9" class="text-center text-muted py-5">
                <i class="fas fa-flask fa-2x mb-3 d-block"></i><%= t.procedures.noLab %>
              </td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
<%- include("../../partials/footer") %>










