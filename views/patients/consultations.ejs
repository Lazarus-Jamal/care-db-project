<%- include("../partials/header", { title: t.patients.consultations }) %>
<style>
  .content-wrapper { background-color: #f0f2f5; }
  .card { background: #fff !important; }
  tbody tr:nth-child(odd) > td,
  tbody tr:nth-child(odd) > th  { background-color: #f0f4ff !important; }
  tbody tr:nth-child(even) > td,
  tbody tr:nth-child(even) > th { background-color: #ffffff !important; }
  tbody tr:hover > td,
  tbody tr:hover > th           { background-color: #dce8ff !important; }
</style>
<%- include("../partials/navbar") %>
<div class="container-fluid py-3 px-4 content-wrapper">
  <div class="card shadow-sm">
    <div class="card-header bg-primary text-white">
      <h5 class="mb-0"><i class="fas fa-stethoscope me-2"></i><%= t.patients.consultations %></h5>
    </div>
    <div class="card-body">
      <form method="GET" action="/patients/consultations" class="row g-2 mb-3">
        <div class="col-md-4"><input type="text" name="search" class="form-control form-control-sm" placeholder="..."></div>
        <div class="col-md-2"><input type="date" name="date_from" class="form-control form-control-sm"></div>
        <div class="col-md-2"><input type="date" name="date_to" class="form-control form-control-sm"></div>
        <div class="col-md-2 d-flex gap-2">
          <button type="submit" class="btn btn-primary btn-sm w-100"><%= t.patientList.search %></button>
          <a href="/patients/consultations" class="btn btn-secondary btn-sm w-100"><%= t.patientList.reset %></a>
        </div>
      </form>
      <div class="table-responsive">
        <table class="table table-hover align-middle" style="font-size:0.85rem;">
          <thead class="table-dark"><tr><th>#</th><th>Patient</th><th><%= t.common.date %></th><th><%= t.common.status %></th><th><%= t.common.actions %></th></tr></thead>
          <tbody>
            <% if (typeof items !== "undefined" && items.length > 0) { %>
              <% items.forEach((item, i) => { %><tr><td><%= i+1 %></td><td>—</td><td>—</td><td>—</td><td>—</td></tr><% }) %>
            <% } else { %>
              <tr><td colspan="5" class="text-center text-muted py-5">
                <i class="fas fa-stethoscope fa-2x mb-3 d-block"></i><%= t.patients.noConsultations %>
              </td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
<%- include("../partials/footer") %>












