
<%- include("../partials/header", { title: t.staff.title }) %>
<%- include("../partials/navbar") %>
<style>
  .content-wrapper { background-color: #f0f2f5; }

  tbody tr:nth-child(odd) > td,
  tbody tr:nth-child(odd) > th  { background-color: #f0f4ff !important; }
  tbody tr:nth-child(even) > td,
  tbody tr:nth-child(even) > th { background-color: #ffffff !important; }
  tbody tr:hover > td,
  tbody tr:hover > th           { background-color: #dce8ff !important; }
</style>
<div class="container-fluid py-3 px-4 content-wrapper">
  <div class="card shadow-sm">
    <div class="card-header bg-primary text-white">
      <h5 class="mb-0"><i class="fas fa-users me-2"></i><%= t.staff.title %></h5>
    </div>
    <div class="card-body">
      <form method="GET" action="/staff/list" class="row g-2 mb-3">
        <div class="col-md-3">
          <input type="text" name="search" class="form-control form-control-sm"
            placeholder="<%= t.staff.lastName %>, <%= t.staff.firstName %>..."
            value="<%- typeof search !== "undefined" ? search : "" %>">
        </div>
        <div class="col-md-3">
          <select name="dept_nr" class="form-select form-select-sm">
            <option value="">-- <%= t.staff.dept %> --</option>
            <% if (typeof departments !== "undefined") { departments.forEach(d => { %>
              <option value="<%= d.nr %>" <%= typeof dept_nr !== "undefined" && dept_nr == d.nr ? "selected" : "" %>><%= d.name_short %></option>
            <% }) } %>
          </select>
        </div>
        <div class="col-md-2">
          <select name="status" class="form-select form-select-sm">
            <option value="">-- <%= t.common.status %> --</option>
            <option value="active"><%= t.common.active %></option>
            <option value="inactive"><%= t.common.inactive %></option>
          </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
          <button type="submit" class="btn btn-primary btn-sm w-100"><%= t.patientList.search %></button>
          <a href="/staff/list" class="btn btn-secondary btn-sm w-100"><%= t.patientList.reset %></a>
        </div>
      </form>
      <div class="table-responsive">
        <table class="table table-hover align-middle" style="font-size:0.85rem;">
          <thead class="table-dark">
            <tr>
              <th>#</th><th><%= t.staff.id %></th><th><%= t.staff.lastName %></th>
              <th><%= t.staff.firstName %></th><th><%= t.staff.email %></th>
              <th><%= t.staff.function %></th><th><%= t.staff.dept %></th>
              <th><%= t.staff.facility %></th><th><%= t.common.status %></th>
            </tr>
          </thead>
          <tbody>
            <% if (typeof staffList !== "undefined" && staffList.length > 0) { %>
              <% staffList.forEach((s, i) => { %>
                <tr>
                  <td><%= i+1 %></td>
                  <td><code><%= s.nr %></code></td>
                  <td><strong><%= s.person ? s.person.name_last : "—" %></strong></td>
                  <td><%= s.person ? s.person.name_first : "—" %></td>
                  <td><%= s.person ? (s.person.email || "—") : "—" %></td>
                  <td><%= s.job_function_title || "—" %></td>
                  <td><% if (s.department) { %><span class="badge bg-secondary"><%= s.department.name_short %></span><% } else { %>—<% } %></td>
                  <td><%= s.facility ? s.facility.name : "—" %></td>
                  <td><span class="badge <%= s.status === "active" ? "bg-success" : "bg-secondary" %>"><%= s.status === "active" ? t.common.active : t.common.inactive %></span></td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="9" class="text-center text-muted py-5">
                <i class="fas fa-users-slash fa-2x mb-3 d-block"></i><%= t.staff.noStaff %>
              </td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
<%- include("../partials/footer") %>










