<%- include("../partials/header", { title: t.finances.payments }) %>
<style>
  .content-wrapper { background-color: #f0f2f5; }
  .card { background: #fff !important; }
  tbody tr:nth-child(odd) > td,
  tbody tr:nth-child(odd) > th  { background-color: #f0f4ff !important; }
  tbody tr:nth-child(even) > td,
  tbody tr:nth-child(even) > th { background-color: #ffffff !important; }
  tbody tr:hover > td,
  tbody tr:hover > th           { background-color: #dce8ff !important; }
</style>
<%- include("../partials/navbar") %>
<div class="container-fluid py-3 px-4 content-wrapper">
  <div class="card shadow-sm">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
      <h5 class="mb-0"><i class="fas fa-money-bill-wave me-2"></i><%= t.finances.payments %></h5>
      
    </div>
    <div class="card-body">
      <form method="GET" action="/finances/payments" class="row g-2 mb-3">
        <div class="col-md-4">
          <input type="text" name="search" class="form-control form-control-sm"
            placeholder="<%= t.common.save %>..."
            value="<%- typeof search !== "undefined" ? search : "" %>">
        </div>
        <div class="col-md-2">
          <input type="date" name="date_from" class="form-control form-control-sm">
        </div>
        <div class="col-md-2">
          <input type="date" name="date_to" class="form-control form-control-sm">
        </div>
        <div class="col-md-2 d-flex gap-2">
          <button type="submit" class="btn btn-primary btn-sm w-100"><%= t.patientList.search %></button>
          <a href="/finances/payments" class="btn btn-secondary btn-sm w-100"><%= t.patientList.reset %></a>
        </div>
      </form>
      <div class="row g-3 mb-3">
    <div class="col-md-4">
      <div class="card text-white bg-success">
        <div class="card-body py-2">
          <small><%= t.finances.todayTotal %></small>
          <h4 class="mb-0"><%= typeof todayTotal !== "undefined" ? todayTotal.toLocaleString(locale === "fr" ? "fr-FR" : "en-GB") : "0" %></h4>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card text-white bg-primary">
        <div class="card-body py-2">
          <small><%= t.finances.monthTotal %></small>
          <h4 class="mb-0"><%= typeof monthTotal !== "undefined" ? monthTotal.toLocaleString(locale === "fr" ? "fr-FR" : "en-GB") : "0" %></h4>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card text-white bg-warning text-dark">
        <div class="card-body py-2">
          <small><%= t.finances.pendingTotal %></small>
          <h4 class="mb-0"><%= typeof pendingTotal !== "undefined" ? pendingTotal.toLocaleString(locale === "fr" ? "fr-FR" : "en-GB") : "0" %></h4>
        </div>
      </div>
    </div>
  </div>

      <div class="table-responsive">
        <table class="table table-hover align-middle" style="font-size:0.85rem;">
          <thead class="table-dark"><tr><th>#</th><th>N° Reçu</th><th>Patient</th><th><%= t.common.date %></th><th>amount</th><th>paymentMode</th><th>N° Facture</th><th><%= t.common.actions %></th></tr></thead>
          <tbody>
            <% if (typeof items !== "undefined" && items.length > 0) { %>
              <% items.forEach((item, i) => { %>
                <tr><td><%= i+1 %></td><% for(let c=1;c<8;c++) { %><td>—</td><% } %></tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="8" class="text-center text-muted py-5">
                <i class="fas fa-money-bill-wave fa-2x mb-3 d-block"></i><%= t.finances.noData %>
              </td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
<%- include("../partials/footer") %>












